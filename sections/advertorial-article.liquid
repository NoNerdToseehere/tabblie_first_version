{%- comment -%}
  Advertorial article — editorial/newspaper-style landing page for paid
  traffic (TOF). Deliberately NOT in the Tabblie design language: the page
  must read as an independent article (styling-system.md does not apply
  here by design). One CTA, no add-to-cart. The small "Advertorial" label
  is required so the page stays a legal advertorial (Reclamecode/UCPD) —
  do not remove it via settings misuse.
{%- endcomment -%}

<div class="advtl">
  <header class="advtl__masthead">
    <span class="advtl__label">Advertorial</span>
    <p class="advtl__publisher">{{ section.settings.publisher | escape }}</p>
    {%- if section.settings.tagline != blank -%}
      <p class="advtl__tagline">{{ section.settings.tagline | escape }}</p>
    {%- endif -%}
  </header>

  <article class="advtl__wrap">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          <h1 class="advtl__h1" {{ block.shopify_attributes }}>{{ block.settings.text }}</h1>

        {%- when 'meta' -%}
          <p class="advtl__meta" {{ block.shopify_attributes }}>
            {{ block.settings.text | escape }}
          </p>

        {%- when 'image' -%}
          {%- if block.settings.image != blank -%}
            <figure class="advtl__figure" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.image | image_url: width: 1360 }}"
                srcset="{{ block.settings.image | image_url: width: 680 }} 680w, {{ block.settings.image | image_url: width: 1360 }} 1360w"
                sizes="(min-width: 720px) 680px, 100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                loading="{% if forloop.index < 3 %}eager{% else %}lazy{% endif %}"
                {% if forloop.index < 3 %}fetchpriority="high"{% endif %}
              >
              {%- if block.settings.caption != blank -%}
                <figcaption class="advtl__caption">{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}

        {%- when 'text' -%}
          <div class="advtl__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

        {%- when 'subheading' -%}
          <h2 class="advtl__h2" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

        {%- when 'option' -%}
          <section class="advtl__option" {{ block.shopify_attributes }}>
            <div class="advtl__option-head">
              <span class="advtl__option-num" aria-hidden="true">{{ block.settings.number }}</span>
              <h2 class="advtl__option-title">{{ block.settings.title | escape }}</h2>
            </div>
            <div class="advtl__text">{{ block.settings.text }}</div>
            {%- if block.settings.verdict != blank -%}
              <p class="advtl__verdict"><strong>Kort gezegd:</strong> {{ block.settings.verdict | escape }}</p>
            {%- endif -%}
          </section>

        {%- when 'pullquote' -%}
          <blockquote class="advtl__pullquote" {{ block.shopify_attributes }}>
            {{ block.settings.text | escape }}
          </blockquote>

        {%- when 'source' -%}
          <aside class="advtl__source" {{ block.shopify_attributes }}>
            <p class="advtl__source-quote">{{ block.settings.text }}</p>
            {%- if block.settings.url != blank -%}
              <p class="advtl__source-credit">
                Bron: <a href="{{ block.settings.url }}" target="_blank" rel="noopener nofollow">{{ block.settings.source_name | escape }}</a>
              </p>
            {%- else -%}
              <p class="advtl__source-credit">Bron: {{ block.settings.source_name | escape }}</p>
            {%- endif -%}
          </aside>

        {%- when 'stat' -%}
          <div class="advtl__stat" {{ block.shopify_attributes }}>
            <span class="advtl__stat-number">{{ block.settings.number | escape }}</span>
            <span class="advtl__stat-label">{{ block.settings.label | escape }}</span>
          </div>

        {%- when 'objection' -%}
          <div class="advtl__objection" {{ block.shopify_attributes }}>
            <h3 class="advtl__objection-q">&ldquo;{{ block.settings.question | escape }}&rdquo;</h3>
            <div class="advtl__text">{{ block.settings.answer }}</div>
          </div>

        {%- when 'offer' -%}
          <aside class="advtl__offer" {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <p class="advtl__offer-kicker">{{ block.settings.kicker | escape }}</p>
            {%- endif -%}
            <h2 class="advtl__offer-title">{{ block.settings.title | escape }}</h2>
            <div class="advtl__text advtl__offer-text">{{ block.settings.text }}</div>
            {%- if block.settings.cta_url != blank -%}
              <a class="advtl__cta" href="{{ block.settings.cta_url }}">{{ block.settings.cta_label | escape }}</a>
            {%- endif -%}
            {%- if block.settings.note != blank -%}
              <p class="advtl__offer-note">{{ block.settings.note | escape }}</p>
            {%- endif -%}
          </aside>

        {%- when 'divider' -%}
          <hr class="advtl__divider" {{ block.shopify_attributes }}>

      {%- endcase -%}
    {%- endfor -%}

    <footer class="advtl__disclosure">
      {{ section.settings.disclosure }}
    </footer>
  </article>
</div>

{% style %}
  .advertorial-body { background: #fdfdfb; }

  .advtl {
    color: #1c1c1c;
    font-family: 'Lora', Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  .advtl__masthead {
    position: relative;
    text-align: center;
    padding: 22px 16px 14px;
    border-bottom: 3px double #1c1c1c;
    margin-bottom: 8px;
  }
  .advtl__label {
    position: absolute;
    top: 8px;
    right: 10px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8a8a;
    border: 1px solid #cfcfcf;
    border-radius: 3px;
    padding: 2px 6px;
  }
  .advtl__publisher {
    margin: 0;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .advtl__tagline {
    margin: 2px 0 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6f6f6f;
  }

  .advtl__wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 26px 20px 56px;
  }

  .advtl__h1 {
    font-size: 30px;
    line-height: 1.2;
    font-weight: 700;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }

  .advtl__meta {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #757575;
    border-bottom: 1px solid #e4e2dd;
    padding-bottom: 14px;
    margin: 0 0 22px;
  }

  .advtl__figure { margin: 26px 0; }
  .advtl__figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }
  .advtl__caption {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12.5px;
    color: #7d7d7d;
    padding-top: 7px;
  }

  .advtl__text p { margin: 0 0 1.15em; }
  .advtl__text p:last-child { margin-bottom: 0; }
  .advtl__text ul { margin: 0 0 1.15em; padding-left: 1.3em; }
  .advtl__text li { margin-bottom: 0.4em; }
  .advtl__text a { color: #1c1c1c; }

  .advtl__h2 {
    font-size: 23px;
    line-height: 1.3;
    font-weight: 700;
    margin: 38px 0 12px;
  }

  .advtl__option {
    border: 1px solid #e0ded8;
    border-radius: 6px;
    background: #ffffff;
    padding: 20px 18px;
    margin: 30px 0;
  }
  .advtl__option-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .advtl__option-num {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #1c1c1c;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    font-weight: 700;
  }
  .advtl__option-title {
    font-size: 21px;
    line-height: 1.25;
    font-weight: 700;
    margin: 0;
  }
  .advtl__verdict {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14.5px;
    color: #555;
    background: #f6f4ef;
    border-radius: 4px;
    padding: 9px 12px;
    margin: 14px 0 0;
  }

  .advtl__pullquote {
    font-size: 22px;
    line-height: 1.45;
    font-style: italic;
    border-left: 4px solid #1c1c1c;
    margin: 30px 0;
    padding: 4px 0 4px 18px;
  }

  .advtl__source {
    background: #f6f4ef;
    border-radius: 6px;
    padding: 16px 18px;
    margin: 26px 0;
    font-size: 16px;
  }
  .advtl__source-quote { margin: 0 0 8px; font-style: italic; }
  .advtl__source-credit {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #6f6f6f;
  }
  .advtl__source-credit a { color: #6f6f6f; }

  .advtl__stat {
    text-align: center;
    margin: 34px 0;
  }
  .advtl__stat-number {
    display: block;
    font-size: 46px;
    font-weight: 700;
    line-height: 1;
  }
  .advtl__stat-label {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    color: #6f6f6f;
    margin-top: 6px;
  }

  .advtl__objection { margin: 26px 0; }
  .advtl__objection-q {
    font-size: 19px;
    font-weight: 700;
    font-style: italic;
    margin: 0 0 8px;
  }

  .advtl__offer {
    border: 2px solid #1c1c1c;
    border-radius: 8px;
    background: #ffffff;
    text-align: center;
    padding: 26px 20px;
    margin: 38px 0 26px;
  }
  .advtl__offer-kicker {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b0500f;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .advtl__offer-title {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.25;
  }
  .advtl__offer-text { font-size: 17px; }
  .advtl__cta {
    display: inline-block;
    background: #E8622A;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    padding: 15px 34px;
    margin-top: 16px;
    min-height: 48px;
  }
  .advtl__cta:hover { background: #d4551f; color: #ffffff; }
  .advtl__offer-note {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #6f6f6f;
    margin: 12px 0 0;
  }

  .advtl__divider {
    border: 0;
    border-top: 1px solid #e4e2dd;
    margin: 34px 0;
  }

  .advtl__disclosure {
    border-top: 1px solid #e4e2dd;
    margin-top: 44px;
    padding-top: 16px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12.5px;
    color: #8a8a8a;
  }
  .advtl__disclosure p { margin: 0 0 6px; }
  .advtl__disclosure a { color: #8a8a8a; }

  @media (min-width: 720px) {
    .advtl { font-size: 19px; }
    .advtl__publisher { font-size: 32px; }
    .advtl__h1 { font-size: 38px; }
    .advtl__h2 { font-size: 26px; }
    .advtl__wrap { padding-top: 34px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Advertorial artikel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "publisher", "label": "Uitgever (masthead)", "default": "Slim Huishouden" },
    { "type": "text", "id": "tagline", "label": "Tagline onder masthead" },
    { "type": "richtext", "id": "disclosure", "label": "Disclosure (onderaan)", "default": "<p>Deze pagina is een advertorial van Tabblie.</p>" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Kop (H1)",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Kop" }]
    },
    {
      "type": "meta",
      "name": "Auteur/datum regel",
      "settings": [{ "type": "text", "id": "text", "label": "Tekst" }]
    },
    {
      "type": "image",
      "name": "Afbeelding",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "text", "id": "caption", "label": "Bijschrift" }
      ]
    },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [{ "type": "richtext", "id": "text", "label": "Tekst" }]
    },
    {
      "type": "subheading",
      "name": "Tussenkop (H2)",
      "settings": [{ "type": "text", "id": "text", "label": "Tekst" }]
    },
    {
      "type": "option",
      "name": "Optie (genummerd)",
      "settings": [
        { "type": "text", "id": "number", "label": "Nummer", "default": "1" },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "richtext", "id": "text", "label": "Tekst" },
        { "type": "text", "id": "verdict", "label": "Kort gezegd (oordeel)" }
      ]
    },
    {
      "type": "pullquote",
      "name": "Uitgelichte quote",
      "settings": [{ "type": "text", "id": "text", "label": "Quote" }]
    },
    {
      "type": "source",
      "name": "Bron / studie",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Samenvatting/citaat" },
        { "type": "text", "id": "source_name", "label": "Bronnaam" },
        { "type": "url", "id": "url", "label": "Link naar bron" }
      ]
    },
    {
      "type": "stat",
      "name": "Statistiek",
      "settings": [
        { "type": "text", "id": "number", "label": "Getal", "default": "94%" },
        { "type": "text", "id": "label", "label": "Omschrijving" }
      ]
    },
    {
      "type": "objection",
      "name": "Bezwaar + antwoord",
      "settings": [
        { "type": "text", "id": "question", "label": "Bezwaar (vraag)" },
        { "type": "richtext", "id": "answer", "label": "Antwoord" }
      ]
    },
    {
      "type": "offer",
      "name": "Aanbod + CTA",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker (klein, boven titel)" },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "richtext", "id": "text", "label": "Tekst" },
        { "type": "text", "id": "cta_label", "label": "Knoptekst" },
        { "type": "url", "id": "cta_url", "label": "Knop link" },
        { "type": "text", "id": "note", "label": "Notitie onder knop" }
      ]
    },
    {
      "type": "divider",
      "name": "Scheidingslijn",
      "settings": []
    }
  ]
}
{% endschema %}
