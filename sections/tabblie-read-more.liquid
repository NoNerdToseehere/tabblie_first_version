{%- comment -%}
  "Lees meer" CTA banner under blog articles: one big button to the
  De schone was blog index instead of an article grid or prev/next links.
{%- endcomment -%}

<section class="tabblie-rmore">
  <div class="tabblie-rmore__container">
    <h2 class="tabblie-rmore__title">{{ section.settings.title | default: 'Meer verhalen voor een schoner huis' | escape }}</h2>
    <a class="tabblie-rmore__btn" href="{{ section.settings.button_url | default: '/blogs/de-schone-was' }}">
      {{ section.settings.button_text | default: 'Bekijk alle verhalen' | escape }}
      <svg width="15" height="15" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 16h20M18 9l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

{% style %}
  .tabblie-rmore {
    background: #ffffff;
    padding: 44px 20px 56px;
    border-top: 3px double rgba(24, 45, 32, 0.35);
    text-align: center;
  }
  .tabblie-rmore__container { max-width: 1170px; margin: 0 auto; }
  .tabblie-rmore__title {
    font-family: var(--font-heading-family);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #182D20;
    margin: 0 0 18px;
  }
  .tabblie-rmore__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #E8622A;
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
    border-radius: 999px;
    padding: 16px 36px;
    min-height: 52px;
  }
  .tabblie-rmore__btn:hover { background: #D4531D; color: #ffffff; }
  @media (min-width: 768px) {
    .tabblie-rmore__title { font-size: 28px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Lees meer (knop)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Meer verhalen voor een schoner huis" },
    { "type": "text", "id": "button_text", "label": "Knoptekst", "default": "Bekijk alle verhalen" },
    { "type": "url", "id": "button_url", "label": "Knop link" }
  ],
  "presets": [{ "name": "Lees meer (knop)" }]
}
{% endschema %}
