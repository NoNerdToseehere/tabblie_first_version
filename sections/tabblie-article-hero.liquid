{%- comment -%}
  tabblie-article-hero.liquid
  Simple opener for every blog article (founder reference 2026-09-03: the
  "Even eerlijk" page hero). A pastel band, everything centred: the
  category as dashed eyebrow, the article title with the part after the
  colon in orange on its own line, the excerpt as subline. No photo, no
  date, no author, no chip. Carries the page's single h1 — keep "Hide
  article title" on in the main article section.
{%- endcomment -%}

{%- liquid
  assign cats = 'Waswijs,Plasticpraat,Onze producten,Hacks,Schermen' | split: ','
  assign cat = ''
  for tag in article.tags
    if cats contains tag and cat == ''
      assign cat = tag
    endif
  endfor
  assign eyebrow = section.settings.eyebrow | default: cat
  if eyebrow == blank
    assign eyebrow = blog.title
  endif

  assign bg = section.settings.bg_color
  if section.settings.color_by_category
    case cat
      when 'Waswijs'
        assign bg = '#FDEEE6'
      when 'Plasticpraat'
        assign bg = '#E2F2ED'
      when 'Onze producten'
        assign bg = '#FDF5DD'
      when 'Hacks'
        assign bg = '#FCE8E8'
      when 'Schermen'
        assign bg = '#E1ECFA'
    endcase
  endif

  assign parts = article.title | split: ': '
  assign title_main = article.title
  assign title_accent = ''
  if parts.size > 1
    assign title_main = parts[0] | append: ':'
    assign title_accent = parts | slice: 1, 6 | join: ': '
  endif
-%}

<style>
  .tabblie-ahero {
    background-color: var(--ahero-bg, #FDEEE6);
    /* same air as the "Even eerlijk" page hero: roomy above the eyebrow, roomier below the subline */
    padding: clamp(48px, 6vw, 88px) clamp(16px, 3vw, 40px) clamp(60px, 8vw, 116px);
    text-align: center;
  }
  .tabblie-ahero__inner { max-width: 780px; margin: 0 auto; }
  .tabblie-ahero__eyebrow {
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin: 0 0 18px;
  }
  .tabblie-ahero__title {
    font-family: var(--heading-font-family);
    font-size: clamp(30px, 5.4vw, 52px) !important;
    font-weight: 700;
    line-height: 1.08 !important;
    letter-spacing: -0.02em;
    color: #26523F;
    margin: 0 0 22px;
    text-transform: none;
    text-wrap: balance;
  }
  .tabblie-ahero__accent { display: block; color: #E8622A; }
  .tabblie-ahero__sub {
    font-family: var(--text-font-family);
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.7;
    color: rgba(24, 45, 32, 0.6);
    margin: 0 auto;
    max-width: 600px;
  }
</style>

<section class="tabblie-ahero" style="--ahero-bg: {{ bg }};">
  <div class="tabblie-ahero__inner">
    {%- if eyebrow != blank -%}
      <p class="tabblie-ahero__eyebrow">{{ eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="tabblie-ahero__title">
      {{- title_main | escape -}}
      {%- if title_accent != blank %} <span class="tabblie-ahero__accent">{{ title_accent | escape }}</span>{%- endif -%}
    </h1>
    {%- if article.excerpt != blank -%}
      <p class="tabblie-ahero__sub">{{ article.excerpt | strip_html }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Artikel hero",
  "tag": "section",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "paragraph", "content": "Categorie, titel en intro komen uit het artikel zelf. Zet bij de sectie 'Blog post' de titel en hoofdfoto uit, zodat de pagina één h1 houdt." },
    { "type": "checkbox", "id": "color_by_category", "label": "Achtergrond op basis van categorie", "info": "Waswijs oranje, Plasticpraat teal, Onze producten geel, Hacks roze, Schermen blauw.", "default": true },
    { "type": "color", "id": "bg_color", "label": "Achtergrond (als categoriekleur uit staat of geen categorie)", "default": "#FDEEE6" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (leeg = categorie)" }
  ],
  "presets": [{ "name": "Artikel hero" }]
}
{% endschema %}
