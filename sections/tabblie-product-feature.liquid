{%- comment -%}
  tabblie-product-feature.liquid
  Colleins-style split image + text feature section.
  Brand: Tabblie — cream background, Fraunces heading, orange accent.
{%- endcomment -%}

<style>
  .tabblie-pf {
    background-color: #FFFFFF;
    padding: clamp(24px, 3vw, 44px) clamp(16px, 3vw, 40px) clamp(48px, 6vw, 84px);
  }

  .tabblie-pf__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .tabblie-pf__inner--reversed {
    direction: rtl;
  }

  .tabblie-pf__inner--reversed > * {
    direction: ltr;
  }

  /* Image side */
  .tabblie-pf__media {
    border-radius: 20px;
    overflow: hidden;
    /* square source art in a 4/5 frame gets its overlay pills cropped —
       set the ratio per section to match the photo */
    aspect-ratio: var(--pf-media-ratio, 4 / 5);
    background-color: rgba(232, 98, 42, 0.08);
    position: relative;
  }

  .tabblie-pf__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .tabblie-pf__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(232,98,42,0.12) 0%, rgba(243,226,206,0.6) 100%);
    min-height: 400px;
  }

  /* Text side */
  .tabblie-pf__content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .tabblie-pf__eyebrow {
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin-bottom: 16px;
  }

  .tabblie-pf__title {
    font-family: var(--heading-font-family);
    font-size: clamp(2.2rem, 3.5vw, 3.4rem);
    font-weight: 700;
    color: #26523F;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 20px;
  }

  .tabblie-pf__desc {
    font-family: var(--text-font-family);
    font-size: 16px;
    color: rgba(24, 45, 32, 0.65);
    line-height: 1.7;
    margin: 0 0 36px;
  }

  /* Benefit bullets */
  .tabblie-pf__benefits {
    list-style: none;
    margin: 0 0 44px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tabblie-pf__benefit {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--text-font-family);
    font-size: 15px;
    color: #182D20;
    line-height: 1.5;
  }

  .tabblie-pf__benefit-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: #26523F;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .tabblie-pf__benefit-icon svg {
    color: #FFFFFF;
  }

  /* CTA */
  .tabblie-pf__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--text-font-family);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    background-color: #E8622A;
    border: none;
    border-radius: 100px;
    padding: 17px 36px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    align-self: flex-start;
  }

  .tabblie-pf__cta:hover,
  .tabblie-pf__cta:focus {
    background-color: #cf531e;
    color: #FFFFFF !important;
    transform: translateY(-1px);
  }

  .tabblie-pf__cta svg {
    transition: transform 0.2s ease;
  }

  .tabblie-pf__cta:hover svg {
    transform: translateX(3px);
  }

  /* Mobile */
  @media (max-width: 749px) {
    .tabblie-pf {
      padding: 64px 20px;
    }

    .tabblie-pf__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .tabblie-pf__inner--reversed {
      direction: ltr;
    }

    .tabblie-pf__media {
      aspect-ratio: var(--pf-media-ratio-mobile, var(--pf-media-ratio, 4 / 3));
    }

    .tabblie-pf__title {
      font-size: clamp(2rem, 8vw, 2.8rem);
    }

    .tabblie-pf__benefits {
      margin-bottom: 32px;
    }
  }
</style>

<style>
  .tabblie-pf__doodle { position: absolute; height: auto; pointer-events: none; }
  @media (max-width: 749px) { .tabblie-pf__doodle { display: none; } }
</style>
<section class="tabblie-pf" id="tabblie-pf-{{ section.id }}" style="position:relative;overflow:hidden;--pf-media-ratio:{{ section.settings.image_ratio | default: '4 / 5' }}">
  {%- liquid
    assign doodle = section.settings.doodle | default: 'stripes'
  -%}
  {%- case doodle -%}
    {%- when 'stripes' -%}
      <svg class="tabblie-pf__doodle" style="bottom:42px;right:5%;width:clamp(56px,7vw,92px);color:#26523F;transform:rotate(20deg) scaleX(-1)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 14 8 8"/><path d="M10 16l2-8"/><path d="M15 17l4-6"/></svg>
    {%- when 'star' -%}
      <svg class="tabblie-pf__doodle" style="top:38px;right:6%;width:clamp(40px,4.5vw,58px);transform:rotate(14deg)" viewBox="0 0 64 64" aria-hidden="true"><path d="m32 5 7 18 20 1-16 12 5 20-16-11-17 11 6-20L5 24l20-1Z" fill="none" stroke="#F5C842" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'bubbles' -%}
      <svg class="tabblie-pf__doodle" style="bottom:28px;{% if section.settings.image_side == 'left' %}right:4%{% else %}left:4%{% endif %};width:clamp(64px,8vw,110px);color:#5BB8A0;opacity:0.35" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><circle cx="42" cy="54" r="33" opacity="0.35"/><circle cx="42" cy="54" r="33" fill="none" stroke="currentColor" stroke-width="3"/><path d="M22 46 A 23 23 0 0 1 33 31" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/><circle cx="79" cy="28" r="13" opacity="0.35"/><circle cx="79" cy="28" r="13" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="86" cy="68" r="6" opacity="0.55"/></svg>
  {%- endcase -%}
  <div class="tabblie-pf__inner{% if section.settings.image_side == 'right' %} tabblie-pf__inner--reversed{% endif %}">

    <div class="tabblie-pf__media">
      {%- if section.settings.image != blank -%}
        {%- comment -%}
          Prefer the image's own alt text (set in Shopify Files) over the
          heading (2026-08-16). Falling back to the title described the
          section, not the picture, which is no use to screen readers or
          image search.
        {%- endcomment -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
          width="900"
          height="1125"
          loading="lazy"
        >
      {%- else -%}
        <img
          src="{{ 'tabblie-product-feature.png' | asset_url }}"
          alt="{{ section.settings.title | escape }}"
          width="900"
          height="1125"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="tabblie-pf__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tabblie-pf__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="tabblie-pf__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="tabblie-pf__desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="tabblie-pf__benefits">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="tabblie-pf__benefit" {{ block.shopify_attributes }}>
                <span class="tabblie-pf__benefit-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 256 256" fill="currentColor">
                    <path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/>
                  </svg>
                </span>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_text != blank -%}
        <a class="tabblie-pf__cta" href="{{ section.settings.button_url | default: '#' }}">
          {{ section.settings.button_text }}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Feature",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Beeldverhouding",
      "info": "Kies 1:1 als de foto vierkant is, anders wordt hij bijgesneden.",
      "options": [
        { "value": "4 / 5", "label": "Staand (4:5)" },
        { "value": "1 / 1", "label": "Vierkant (1:1)" },
        { "value": "4 / 3", "label": "Liggend (4:3)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "doodle",
      "label": "Doodle",
      "default": "stripes",
      "options": [
        { "value": "stripes", "label": "Streepjes (rechtsonder)" },
        { "value": "star", "label": "Ster (rechtsboven)" },
        { "value": "bubbles", "label": "Bubbels (linksonder)" },
        { "value": "none", "label": "Geen" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "One strip. Zero bottles. Actually clean."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Tabblie strips dissolve instantly in water — no measuring, no plastic, no mess. Just clean laundry, dishes, and surfaces every time."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Dissolves in any water temperature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Feature",
      "settings": {
        "eyebrow": "Why tabblie?",
        "title": "One strip. Zero bottles. Actually clean.",
        "description": "Tabblie strips dissolve instantly in water — no measuring, no plastic, no mess. Just clean laundry, dishes, and surfaces every time.",
        "button_text": "Shop the strips",
        "image_side": "left"
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": { "text": "Works in any washing machine or dishwasher" }
        },
        {
          "type": "benefit",
          "settings": { "text": "Dissolves in hot and cold water" }
        },
        {
          "type": "benefit",
          "settings": { "text": "No plastic bottles — ever" }
        },
        {
          "type": "benefit",
          "settings": { "text": "Vegan formula, cruelty-free certified" }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
