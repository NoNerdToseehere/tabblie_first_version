{%- comment -%}
  tabblie-product-cards.liquid
  "Kies je strip" — the strips side by side as clean product tiles (one
  screen instead of three full-width product rows). Each tile: pastel
  identity colour, the pack render, optional sticker badge, kicker, name,
  pack size + price and one orange add-to-cart button. Below 1024px the
  tiles form a horizontal snap-scroll row. No benefit lists and no social
  proof here — the surrounding sections and the PDP cover both.
  Collection mode (2026-09-03): on a collection template the tiles can come
  from `collection.products` instead of blocks; colour, kicker and badge
  are derived from the product handle.
{%- endcomment -%}

<style>
  .tabblie-pc {
    --pc-card-w: min(80vw, 340px);
    background-color: #FDF6EE;
    padding: clamp(52px, 6vw, 88px) 0;
    position: relative;
    overflow: hidden;
  }

  .tabblie-pc__header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto clamp(24px, 3.5vw, 40px);
    padding: 0 20px;
  }

  .tabblie-pc__eyebrow {
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin: 0 0 14px;
  }

  .tabblie-pc__title {
    font-family: var(--heading-font-family);
    font-size: clamp(28px, 22px + 1.6vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #26523F;
    margin: 0 auto;
    max-width: 760px;
    text-transform: none;
    text-wrap: balance;
  }

  .tabblie-pc__intro {
    font-family: var(--text-font-family);
    font-size: 16px;
    line-height: 1.5;
    color: rgba(24, 45, 32, 0.7);
    margin: 12px auto 0;
    max-width: 560px;
  }

  /* Row: swipe rail on phone/tablet, three columns from 1024px */
  .tabblie-pc__grid {
    display: flex;
    align-items: stretch;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 10px calc((100% - var(--pc-card-w)) / 2) 26px;
    margin: 0;
    list-style: none;
  }

  .tabblie-pc__grid::-webkit-scrollbar { display: none; }

  /* Tile */
  .tabblie-pc__card {
    --pc-bg: #FDF6EE;
    --pc-accent: #E8622A;
    position: relative;
    flex: 0 0 var(--pc-card-w);
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    background-color: var(--pc-bg);
    border-radius: 24px;
    padding: 14px 14px 18px;
    box-shadow: 0 8px 24px rgba(232, 98, 42, 0.12);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tabblie-pc__card--wasstrips    { --pc-bg: #FDEEE6; --pc-accent: #E8622A; }
  .tabblie-pc__card--vaatwas      { --pc-bg: #FDF5DD; --pc-accent: #F5C842; }
  .tabblie-pc__card--toilet       { --pc-bg: #E2F2ED; --pc-accent: #5BB8A0; }
  .tabblie-pc__card--allesreiniger{ --pc-bg: #FCE8E8; --pc-accent: #F2A0A0; }
  .tabblie-pc__card--cream        { --pc-bg: #FFFFFF; }

  @media (hover: hover) {
    .tabblie-pc__card:hover {
      transform: translateY(-5px);
      box-shadow: 0 14px 30px rgba(232, 98, 42, 0.18);
    }
  }

  /* Sticker badge on the photo (ink outline — a detail, per §11) */
  .tabblie-pc__badge {
    position: absolute;
    z-index: 2;
    top: 22px;
    left: 22px;
    padding: 7px 12px;
    border-radius: 100px;
    background: #E8622A;
    color: #FFFFFF;
    font-family: var(--text-font-family);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    border: 2px solid #1F1209;
    box-shadow: 2px 3px 0 rgba(31, 18, 9, 0.25);
    transform: rotate(-4deg);
    pointer-events: none;
  }

  /* Photo: the pack floats on the pastel, no inner box */
  .tabblie-pc__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
  }

  .tabblie-pc__media img {
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    padding: 14px;
    display: block;
    filter: drop-shadow(0 10px 14px rgba(24, 45, 32, 0.18));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (hover: hover) {
    .tabblie-pc__card:hover .tabblie-pc__media img { transform: scale(1.05) rotate(-2deg); }
  }

  .tabblie-pc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 14px 6px 0;
  }

  .tabblie-pc__kicker {
    font-family: var(--text-font-family);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin: 0 0 6px;
  }

  .tabblie-pc__name {
    font-family: var(--heading-font-family);
    font-size: 23px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: #26523F;
    margin: 0 0 6px;
  }

  .tabblie-pc__name a { color: inherit; text-decoration: none; }

  .tabblie-pc__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 0 16px;
    font-family: var(--text-font-family);
    font-size: 14px;
    line-height: 1.4;
    color: rgba(24, 45, 32, 0.72);
  }

  .tabblie-pc__price {
    order: -1;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
    color: #182D20;
  }

  .tabblie-pc__price s {
    margin-left: 6px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(24, 45, 32, 0.5);
  }

  .tabblie-pc__form { margin: auto 0 0; }

  .tabblie-pc__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 50px;
    margin: 0;
    padding: 13px 20px;
    border: 0;
    border-radius: 100px;
    background: #E8622A;
    color: #FFFFFF;
    font-family: var(--text-font-family);
    font-size: 16px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(232, 98, 42, 0.22);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .tabblie-pc__atc svg { width: 19px; height: 19px; flex-shrink: 0; fill: #FFFFFF; }

  .tabblie-pc__atc:hover { background: #d4551f; color: #FFFFFF; transform: translateY(-2px); }
  .tabblie-pc__atc:focus-visible { outline: 3px solid #26523F; outline-offset: 3px; }
  .tabblie-pc__atc[disabled] { background: rgba(24, 45, 32, 0.35); box-shadow: none; cursor: not-allowed; }

  /* One-line trust strip under the tiles */
  .tabblie-pc__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    margin: 4px auto 0;
    padding: 0 20px;
    list-style: none;
  }

  .tabblie-pc__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--text-font-family);
    font-size: 14px;
    font-weight: 700;
    color: #182D20;
  }

  .tabblie-pc__chip {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #26523F;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tabblie-pc__chip svg { width: 12px; height: 12px; }

  /* phones: one aligned column instead of a ragged two-line wrap */
  @media (max-width: 749px) {
    .tabblie-pc__trust {
      flex-direction: column;
      align-items: flex-start;
      width: fit-content;
      gap: 8px;
    }
  }

  /* One faint background bubble top-left, same as "Onze garantie" (desktop only) */
  .tabblie-pc__leaf {
    position: absolute;
    top: 40px;
    left: 3%;
    width: 110px;
    height: 110px;
    color: #5BB8A0;
    opacity: 0.12;
    transform: rotate(-30deg);
    pointer-events: none;
    z-index: 0;
    display: none;
  }

  @media (min-width: 750px) {
    .tabblie-pc { --pc-card-w: 360px; }
    .tabblie-pc__leaf { display: block; }
    .tabblie-pc__grid { gap: 24px; }
  }

  @media (min-width: 1024px) {
    .tabblie-pc__grid {
      display: grid;
      /* three 340px tiles fit the 1100px grid; a lone tile stays 340px and centred */
      grid-template-columns: repeat(auto-fit, minmax(280px, 340px));
      justify-content: center;
      gap: 28px;
      overflow: visible;
      max-width: 1180px;
      margin: 0 auto;
      padding: 10px 40px 18px;
      scroll-snap-type: none;
    }
    .tabblie-pc__card { flex: initial; padding: 16px 16px 20px; }
    .tabblie-pc__body { padding-top: 16px; }
    .tabblie-pc__trust { margin-top: 22px; }
  }

  /* When the "Nog heel even geduld" teaser follows directly, tuck it under
     the tiles at the same width so both read as one "Kies je strip" section */
  .shopify-section:has(> .tabblie-pc):has(+ .shopify-section .tabblie-cs) .tabblie-pc {
    padding-bottom: 12px;
  }
  .shopify-section:has(> .tabblie-pc) + .shopify-section .tabblie-cs {
    margin-top: 0;
    max-width: 1076px; /* three 340px tiles + two 28px gaps */
    width: calc(100% - 40px);
  }
  @media (max-width: 749px) {
    .shopify-section:has(> .tabblie-pc) + .shopify-section .tabblie-cs {
      width: calc(100% - 24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tabblie-pc__card,
    .tabblie-pc__media img { transition: none; }
  }
</style>

{%- if section.settings.anchor_id != blank -%}
  <div id="{{ section.settings.anchor_id | handle }}" aria-hidden="true" style="display:block;height:1px;margin-top:-1px;scroll-margin-top:90px"></div>
{%- endif -%}

<section class="tabblie-pc" id="tabblie-pc-{{ section.id }}">
  <svg class="tabblie-pc__leaf" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <circle cx="42" cy="54" r="33" fill="currentColor" opacity="0.35"/><circle cx="42" cy="54" r="33" fill="none" stroke="currentColor" stroke-width="3"/><path d="M22 46 A 23 23 0 0 1 33 31" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" opacity="0.9"/><circle cx="79" cy="28" r="13" fill="currentColor" opacity="0.35"/><circle cx="79" cy="28" r="13" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M71 25 A 9 9 0 0 1 75 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.9"/><circle cx="86" cy="68" r="6" fill="currentColor" opacity="0.55"/>
  </svg>

  {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
    <div class="tabblie-pc__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tabblie-pc__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="tabblie-pc__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="tabblie-pc__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign from_collection = false
    if section.settings.use_collection and collection != blank and collection.products.size > 0
      assign from_collection = true
    endif
    assign skip_handles = section.settings.skip_handles | downcase | replace: ' ', '' | split: ','
    if from_collection
      assign items = collection.products
    else
      assign items = section.blocks
    endif
    assign tile_index = 0
  -%}
  <ul class="tabblie-pc__grid">
    {%- for item in items -%}
      {%- liquid
        if from_collection
          assign product = item
          if skip_handles contains product.handle
            continue
          endif
          assign h = product.handle
          assign card_color = 'cream'
          assign kicker = ''
          if h contains 'vaatwas'
            assign card_color = 'vaatwas'
            assign kicker = 'Voor de vaatwasser'
          elsif h contains 'toilet'
            assign card_color = 'toilet'
            assign kicker = 'Voor het toilet'
          elsif h contains 'wasstrip'
            assign card_color = 'wasstrips'
            assign kicker = 'Voor de was'
          elsif h contains 'allesreiniger'
            assign card_color = 'allesreiniger'
            assign kicker = 'Voor het hele huis'
          endif
          assign badge = ''
          if tile_index == 0
            assign badge = section.settings.first_badge
          endif
          assign media_index = section.settings.collection_media_index | default: 2
          assign tagline = ''
          assign name = product.title
          assign button_text = section.settings.collection_button_text | default: 'In winkelwagen'
          assign attrs = ''
        else
          assign block = item
          assign product = block.settings.product
          assign card_color = block.settings.card_color
          assign kicker = block.settings.eyebrow
          assign badge = block.settings.badge
          assign media_index = block.settings.media_index | default: 1
          assign tagline = block.settings.tagline
          assign name = block.settings.title | default: product.title
          assign button_text = block.settings.button_text
          assign attrs = block.shopify_attributes
        endif
        assign tile_index = tile_index | plus: 1
        assign variant = product.selected_or_first_available_variant
        assign media_i = media_index | minus: 1
        if media_i < 0
          assign media_i = 0
        endif
        assign chosen = product.media[media_i]
        if chosen == blank
          assign chosen = product.featured_media
        endif
        if tagline == blank and variant != blank and variant.title != 'Default Title'
          assign tagline = variant.title
        endif
        assign card_class = 'tabblie-pc__card'
        if card_color != blank
          assign card_class = card_class | append: ' tabblie-pc__card--' | append: card_color
        endif
      -%}

      <li class="{{ card_class }}" {{ attrs }}>
        {%- if badge != blank -%}
          <span class="tabblie-pc__badge">{{ badge }}</span>
        {%- endif -%}

        {%- if product != blank -%}
          <a class="tabblie-pc__media" href="{{ product.url }}" aria-label="{{ name | escape }} bekijken">
        {%- else -%}
          <div class="tabblie-pc__media">
        {%- endif -%}
          {%- if chosen != blank -%}
            <img src="{{ chosen.preview_image | image_url: width: 700 }}" alt="{{ name | escape }}" width="700" height="700" loading="lazy">
          {%- elsif from_collection == false and block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ name | escape }}" width="700" height="700" loading="lazy">
          {%- endif -%}
        {%- if product != blank -%}</a>{%- else -%}</div>{%- endif -%}

        <div class="tabblie-pc__body">
          {%- if kicker != blank -%}
            <p class="tabblie-pc__kicker">{{ kicker }}</p>
          {%- endif -%}
          <h3 class="tabblie-pc__name">
            {%- if product != blank -%}<a href="{{ product.url }}">{{ name }}</a>{%- else -%}{{ name }}{%- endif -%}
          </h3>
          {%- if tagline != blank or variant != blank -%}
            <p class="tabblie-pc__meta">
              {%- if tagline != blank -%}<span>{{ tagline }}</span>{%- endif -%}
              {%- if variant != blank -%}
                <span class="tabblie-pc__price">
                  {{ variant.price | money }}
                  {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
                </span>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if product != blank and variant != blank -%}
            <form class="tabblie-pc__form" action="{{ routes.cart_url }}/add" method="post" enctype="multipart/form-data" data-type="add-to-cart-form">
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" name="add" class="tabblie-pc__atc" data-btn-addToCart {% unless variant.available %}disabled{% endunless %}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM7.2 14.6l.1-.1L8.1 13h7.4c.75 0 1.4-.4 1.7-1l3.6-6.5-1.7-1H19L15.5 11H8.5L4.3 2H1v2h2l3.6 7.6-1.35 2.45C4.5 15.4 5.5 17 7 17h12v-2H7.4c-.15 0-.25-.1-.2-.4z"/></svg>
                {%- if variant.available -%}{{ button_text | default: 'In winkelwagen' }}{%- else -%}Uitverkocht{%- endif -%}
              </button>
            </form>
          {%- elsif from_collection -%}
            <a class="tabblie-pc__atc" href="{{ product.url }}">{{ button_text | default: 'Bekijk product' }}</a>
          {%- else -%}
            <a class="tabblie-pc__atc" href="{{ block.settings.button_url | default: '/collections/all' }}">{{ block.settings.button_text | default: 'Ontdek de strips' }}</a>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>

  {%- if section.settings.trust_items != blank -%}
    {%- assign trust = section.settings.trust_items | split: '|' -%}
    <ul class="tabblie-pc__trust">
      {%- for item in trust -%}
        {%- assign item_text = item | strip -%}
        {%- if item_text != blank -%}
          <li>
            <span class="tabblie-pc__chip" aria-hidden="true">
              <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2L5 8.6l4.5-5" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            {{ item_text }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Productkaarten",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-id",
      "info": "Maakt deze sectie linkbaar, bijv. 'tabblie-strips' → link ernaartoe met #tabblie-strips."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kies je strip"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Kop",
      "default": "Welke strip mag het zijn?"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro (optioneel)"
    },
    {
      "type": "text",
      "id": "trust_items",
      "label": "Vertrouwensregel onder de kaarten",
      "info": "Scheid met | — leeg laten om te verbergen.",
      "default": "Gratis verzending vanaf €30|100% plastic- & microplasticvrij|30 dagen proef wassen"
    },
    {
      "type": "header",
      "content": "Collectiepagina"
    },
    {
      "type": "checkbox",
      "id": "use_collection",
      "label": "Toon de producten van deze collectie",
      "info": "Alleen op collectiepagina's: vervangt de blokken hieronder door de producten van de collectie. Kleur en kicker volgen uit de productnaam.",
      "default": false
    },
    {
      "type": "text",
      "id": "skip_handles",
      "label": "Producten overslaan (handles, kommagescheiden)",
      "default": "tabblie-binnenkort"
    },
    {
      "type": "text",
      "id": "first_badge",
      "label": "Badge op het eerste product",
      "default": "Meest gekozen"
    },
    {
      "type": "number",
      "id": "collection_media_index",
      "label": "Productfoto nummer (1 = eerste galerijfoto)",
      "default": 2
    },
    {
      "type": "text",
      "id": "collection_button_text",
      "label": "Knoptekst",
      "default": "In winkelwagen"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "number",
          "id": "media_index",
          "label": "Productfoto nummer (1 = eerste galerijfoto)",
          "default": 2
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding (fallback als er geen productfoto is)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Kicker boven de naam",
          "info": "Bijv. 'Voor de was'"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge op de foto",
          "info": "Bijv. 'Meest gekozen' — leeg laten voor geen badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Naam (leeg = productnaam)"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Regel naast de prijs",
          "info": "Leeg = de variantnaam, bijv. '32 strips (64 wasjes)'"
        },
        {
          "type": "select",
          "id": "card_color",
          "label": "Kaartkleur",
          "options": [
            {
              "value": "cream",
              "label": "Wit"
            },
            {
              "value": "wasstrips",
              "label": "Wasstrips — oranje"
            },
            {
              "value": "vaatwas",
              "label": "Vaatwasstrips — geel"
            },
            {
              "value": "toilet",
              "label": "Toiletstrips — teal"
            },
            {
              "value": "allesreiniger",
              "label": "Allesreiniger — roze"
            }
          ],
          "default": "cream"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Knoptekst",
          "default": "In winkelwagen"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Fallback-link (als geen product gekozen)"
        }
      ]
    }
  ],
  "presets": [
    {
