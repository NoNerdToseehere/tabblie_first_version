{%- comment -%}
  tabblie-comparison.liquid
  Comparison matrix — Tabblie (highlighted column) vs 3 competitor types.
  Brand: cream background, elevated Tabblie column with wordmark, green checks.
{%- endcomment -%}

<style>
  .tabblie-compare {
    background-color: #FDF6EE;
    padding: clamp(48px, 6vw, 88px) clamp(12px, 3vw, 40px);
  }

  .tabblie-compare__inner {
    max-width: 980px;
    margin: 0 auto;
  }

  .tabblie-compare__header-wrap {
    position: relative;
  }

  .tabblie-compare__accent {
    position: absolute;
    color: #26523F;
    width: clamp(46px, 5vw, 72px);
    height: clamp(46px, 5vw, 72px);
    pointer-events: none;
  }

  .tabblie-compare__accent--left {
    top: 4px;
    left: clamp(8px, 7vw, 90px);
    transform: rotate(-18deg) scaleX(-1);
  }

  .tabblie-compare__accent--right {
    top: 0;
    right: clamp(8px, 7vw, 90px);
    transform: rotate(18deg);
  }

  @media (max-width: 749px) {
    .tabblie-compare__accent { display: none; }
  }

  .tabblie-compare__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #182D20;
    text-align: center;
    margin: 0 0 12px;
  }

  .tabblie-compare__heading em {
    color: #E8622A;
    font-style: normal;
    font-weight: 800;
  }

  /* Social-proof avatar cluster */
  .tabblie-compare__avatars {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 14px;
  }

  .tabblie-compare__avatars img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2.5px solid #FDF6EE;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tabblie-compare__avatars img + img,
  .tabblie-compare__avatars .tabblie-compare__avatars-more {
    margin-left: -12px;
  }

  .tabblie-compare__avatars img:hover {
    transform: translateY(-4px) scale(1.08);
    z-index: 5;
  }

  .tabblie-compare__avatars-more {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 0 14px;
    border-radius: 100px;
    background: #E8622A;
    border: 2.5px solid #FDF6EE;
    color: #ffffff;
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 800;
    position: relative;
    z-index: 4;
  }

  @media (max-width: 749px) {
    .tabblie-compare__avatars img { width: 38px; height: 38px; }
    .tabblie-compare__avatars-more { height: 38px; font-size: 11.5px; padding: 0 11px; }
  }

  .tabblie-compare__subtext {
    font-family: var(--text-font-family);
    font-size: clamp(13px, 1.6vw, 15px);
    color: rgba(24, 45, 32, 0.65);
    text-align: center;
    margin: 0 auto clamp(28px, 4vw, 48px);
    max-width: 560px;
    line-height: 1.6;
  }

  /* ── Matrix grid ── */
  .tabblie-compare__matrix {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1.1fr) repeat(3, minmax(0, 1fr));
  }

  .tabblie-compare__mrow {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: stretch;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tabblie-compare__mrow.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tabblie-compare__mcell {
    /* !important beats the theme's div:empty display:none on the blank header cell */
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 13px 8px;
    min-height: 48px;
  }

  .tabblie-compare__mcell--label {
    justify-content: flex-start;
    font-family: var(--text-font-family);
    font-size: 13.5px;
    font-weight: 600;
    color: #182D20;
    text-align: left;
    padding-left: 14px;
    line-height: 1.35;
  }

  /* zebra rows (label + competitor cells) */
  .tabblie-compare__mrow--zebra .tabblie-compare__mcell:not(.tabblie-compare__mcell--tabblie) {
    background-color: #E1ECFA;
  }
  .tabblie-compare__mrow--zebra .tabblie-compare__mcell--label { border-radius: 12px 0 0 12px; }
  .tabblie-compare__mrow--zebra .tabblie-compare__mcell:last-child { border-radius: 0 12px 12px 0; }

  /* ── Elevated Tabblie column ── */
  .tabblie-compare__mcell--tabblie {
    background-color: #FFFFFF;
    border-left: 2px solid #E8622A;
    border-right: 2px solid #E8622A;
    position: relative;
    z-index: 1;
  }

  .tabblie-compare__mrow--head .tabblie-compare__mcell--tabblie {
    border-top: 2px solid #E8622A;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -10px 24px rgba(232, 98, 42, 0.12);
  }

  .tabblie-compare__mrow--last .tabblie-compare__mcell--tabblie {
    border-bottom: 2px solid #E8622A;
    border-radius: 0 0 16px 16px;
    box-shadow: 0 14px 28px rgba(232, 98, 42, 0.16);
  }

  /* ── Header row ── */
  .tabblie-compare__mrow--head .tabblie-compare__mcell {
    padding: 16px 8px 12px;
  }

  .tabblie-compare__brand-logo {
    height: 26px;
    width: auto;
  }

  .tabblie-compare__comp-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: var(--text-font-family);
    font-size: 10.5px;
    font-weight: 600;
    color: rgba(24, 45, 32, 0.55);
    text-align: center;
    line-height: 1.25;
  }

  .tabblie-compare__comp-head svg {
    width: 26px;
    height: 26px;
    color: rgba(24, 45, 32, 0.45);
  }

  /* ── Price row ── */
  .tabblie-compare__price {
    font-family: var(--text-font-family);
    font-size: 13.5px;
    font-weight: 700;
    color: #182D20;
  }

  .tabblie-compare__mcell--tabblie .tabblie-compare__price {
    color: #E8622A;
    font-weight: 800;
    font-size: 15px;
  }

  /* ── Check / X marks ── */
  .tabblie-compare__check,
  .tabblie-compare__xmark {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .tabblie-compare__check {
    background-color: #38A169;
    color: #ffffff;
    transform: scale(0);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s;
  }

  .tabblie-compare__mrow.is-visible .tabblie-compare__check {
    transform: scale(1);
  }

  .tabblie-compare__check svg { width: 13px; height: 13px; }

  .tabblie-compare__xmark {
    background-color: rgba(24, 45, 32, 0.05);
    border: 1.5px solid rgba(24, 45, 32, 0.12);
    color: rgba(24, 45, 32, 0.3);
  }

  .tabblie-compare__xmark svg { width: 10px; height: 10px; }

  .tabblie-compare__footnote {
    font-family: var(--text-font-family);
    font-size: 11px;
    color: rgba(24, 45, 32, 0.45);
    text-align: center;
    margin: 18px 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .tabblie-compare__mrow,
    .tabblie-compare__mrow.is-visible,
    .tabblie-compare__check,
    .tabblie-compare__mrow.is-visible .tabblie-compare__check {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* fallback for browsers without subgrid */
  @supports not (grid-template-columns: subgrid) {
    .tabblie-compare__mrow {
      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1.1fr) repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .tabblie-compare { padding-left: 10px; padding-right: 10px; }

    .tabblie-compare__matrix { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) repeat(3, minmax(0, 0.82fr)); }

    @supports not (grid-template-columns: subgrid) {
      .tabblie-compare__mrow { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) repeat(3, minmax(0, 0.82fr)); }
    }

    .tabblie-compare__mcell { padding: 10px 3px; min-height: 42px; }
    .tabblie-compare__mcell--label { font-size: 11px; padding-left: 8px; }
    .tabblie-compare__price { font-size: 11px; }
    .tabblie-compare__mcell--tabblie .tabblie-compare__price { font-size: 12.5px; }
    .tabblie-compare__check, .tabblie-compare__xmark { width: 20px; height: 20px; }
    .tabblie-compare__check svg { width: 11px; height: 11px; }
    .tabblie-compare__brand-logo { height: 18px; }
    .tabblie-compare__comp-head { font-size: 8.5px; }
    .tabblie-compare__comp-head svg { width: 20px; height: 20px; }
  }
</style>

<section class="tabblie-compare" id="tabblie-compare-{{ section.id }}">
  <div class="tabblie-compare__inner">

    <div class="tabblie-compare__header-wrap">
      <svg class="tabblie-compare__accent tabblie-compare__accent--left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 14 8 8"/><path d="M10 16l2-8"/><path d="M15 17l4-6"/></svg>
      <svg class="tabblie-compare__accent tabblie-compare__accent--right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 14 8 8"/><path d="M10 16l2-8"/><path d="M15 17l4-6"/></svg>
    <h2 class="tabblie-compare__heading">
      Waarom <em>{{ section.settings.heading_accent | default: '1.000+ mensen' }}</em><br>
      {{ section.settings.heading | default: 'kiezen voor Tabblie wasstrips' }}
    </h2>
    {%- if section.settings.show_avatars -%}
      <div class="tabblie-compare__avatars" aria-hidden="true">
        <img src="{{ 'tabblie-avatar-lisa.jpg' | asset_url }}" alt="Lisa, Tabblie klant" width="46" height="46" loading="lazy" style="z-index:4">
        <img src="{{ 'tabblie-avatar-marieke.jpg' | asset_url }}" alt="Marieke, Tabblie klant" width="46" height="46" loading="lazy" style="z-index:3">
        <img src="{{ 'tabblie-avatar-sophie.jpg' | asset_url }}" alt="Sophie, Tabblie klant" width="46" height="46" loading="lazy" style="z-index:2">
        <img src="{{ 'tabblie-avatar-sanne.jpg' | asset_url }}" alt="Sanne, Tabblie klant" width="46" height="46" loading="lazy" style="z-index:1">
        <span class="tabblie-compare__avatars-more">+1.000</span>
      </div>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="tabblie-compare__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}
    </div>

    <div class="tabblie-compare__matrix" role="table" aria-label="Vergelijking Tabblie versus traditionele wasmiddelen">

      {%- comment -%} Header row {%- endcomment -%}
      <div class="tabblie-compare__mrow tabblie-compare__mrow--head" role="row">
        <div class="tabblie-compare__mcell tabblie-compare__mcell--label" role="columnheader"></div>
        <div class="tabblie-compare__mcell tabblie-compare__mcell--tabblie" role="columnheader">
          <img class="tabblie-compare__brand-logo" src="{{ 'tabblie-logo.svg' | asset_url }}" alt="Tabblie" width="90" height="26" loading="lazy">
        </div>
        <div class="tabblie-compare__mcell" role="columnheader">
          <span class="tabblie-compare__comp-head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v3"/><path d="M14 3v3"/><path d="M8 6h8l1 3v11a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9z"/><path d="M7 13h10"/></svg>
            {{ section.settings.comp1_label | default: 'Vloeibaar wasmiddel' }}
          </span>
        </div>
        <div class="tabblie-compare__mcell" role="columnheader">
          <span class="tabblie-compare__comp-head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 4c-2 3-2 13 0 16"/><path d="M4.5 9.5c4-2 11-2 15 0"/></svg>
            {{ section.settings.comp2_label | default: 'Pods & capsules' }}
          </span>
        </div>
        <div class="tabblie-compare__mcell" role="columnheader">
          <span class="tabblie-compare__comp-head">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 9h16"/><path d="M9 14h.01"/><path d="M13 16h.01"/><path d="M12 12.5h.01"/><path d="M15.5 13.5h.01"/><path d="M8.5 17h.01"/></svg>
            {{ section.settings.comp3_label | default: 'Waspoeder' }}
          </span>
        </div>
      </div>

      {%- comment -%} Price row {%- endcomment -%}
      {%- if section.settings.show_price_row -%}
        <div class="tabblie-compare__mrow" role="row">
          <div class="tabblie-compare__mcell tabblie-compare__mcell--label" role="cell">{{ section.settings.price_label | default: 'Prijs per wasbeurt' }}</div>
          <div class="tabblie-compare__mcell tabblie-compare__mcell--tabblie" role="cell"><span class="tabblie-compare__price">{{ section.settings.price_tabblie }}</span></div>
          <div class="tabblie-compare__mcell" role="cell"><span class="tabblie-compare__price">{{ section.settings.price_comp1 }}</span></div>
          <div class="tabblie-compare__mcell" role="cell"><span class="tabblie-compare__price">{{ section.settings.price_comp2 }}</span></div>
          <div class="tabblie-compare__mcell" role="cell"><span class="tabblie-compare__price">{{ section.settings.price_comp3 }}</span></div>
        </div>
      {%- endif -%}

      {%- comment -%} Feature rows {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="tabblie-compare__mrow{% cycle ' tabblie-compare__mrow--zebra', '' %}{% if forloop.last %} tabblie-compare__mrow--last{% endif %}" role="row" {{ block.shopify_attributes }}>
          <div class="tabblie-compare__mcell tabblie-compare__mcell--label" role="cell">{{ block.settings.text | default: block.settings.tabblie_text }}</div>
          <div class="tabblie-compare__mcell tabblie-compare__mcell--tabblie" role="cell">
            <span class="tabblie-compare__check" aria-label="Ja"><svg viewBox="0 0 256 256" fill="currentColor"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/></svg></span>
          </div>
          {%- assign comps = 'c1,c2,c3' | split: ',' -%}
          {%- for c in comps -%}
            <div class="tabblie-compare__mcell" role="cell">
              {%- if block.settings[c] -%}
                <span class="tabblie-compare__check" aria-label="Ja"><svg viewBox="0 0 256 256" fill="currentColor"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/></svg></span>
              {%- else -%}
                <span class="tabblie-compare__xmark" aria-label="Nee"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}

    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="tabblie-compare__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var rows = document.querySelectorAll('#tabblie-compare-{{ section.id }} .tabblie-compare__mrow');
    if (!rows.length) return;
    if (!('IntersectionObserver' in window)) {
      rows.forEach(function (r) { r.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var row = entry.target;
          var idx = Array.prototype.indexOf.call(row.parentNode.children, row);
          row.style.transitionDelay = (idx * 0.06) + 's';
          row.classList.add('is-visible');
          io.unobserve(row);
        }
      });
    }, { threshold: 0.2 });
    rows.forEach(function (r) { io.observe(r); });
  })();
</script>

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "tabblie-comparison-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (oranje deel)",
      "default": "1.000+ mensen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (rest, na 'Waarom [accent]')",
      "default": "kiezen voor Tabblie wasstrips"
    },
    {
      "type": "checkbox",
      "id": "show_avatars",
      "label": "Toon klant-avatars (social proof)",
      "default": true
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtekst",
      "default": "Doe mee met de wasrevolutie en zwaai de dure, ouderwetse, vervuilende wasmiddelen voorgoed uit."
    },
    { "type": "header", "content": "Concurrent-kolommen" },
    { "type": "text", "id": "comp1_label", "label": "Concurrent 1", "default": "Vloeibaar wasmiddel" },
    { "type": "text", "id": "comp2_label", "label": "Concurrent 2", "default": "Pods & capsules" },
    { "type": "text", "id": "comp3_label", "label": "Concurrent 3", "default": "Waspoeder" },
    { "type": "header", "content": "Prijsrij" },
    { "type": "checkbox", "id": "show_price_row", "label": "Toon prijsrij", "default": true },
    { "type": "text", "id": "price_label", "label": "Label", "default": "Prijs per wasbeurt" },
    { "type": "text", "id": "price_tabblie", "label": "Prijs Tabblie", "default": "€0,17" },
    { "type": "text", "id": "price_comp1", "label": "Prijs concurrent 1", "default": "€0,45" },
    { "type": "text", "id": "price_comp2", "label": "Prijs concurrent 2", "default": "€0,38" },
    { "type": "text", "id": "price_comp3", "label": "Prijs concurrent 3", "default": "€0,28" },
    {
      "type": "text",
      "id": "footnote",
      "label": "Voetnoot",
      "default": "*Gemiddelde prijzen per wasbeurt, gebaseerd op adviesprijzen van bekende merken."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Vergelijkingsrij",
      "settings": [
        { "type": "text", "id": "text", "label": "Kenmerk", "default": "Kenmerk" },
        { "type": "checkbox", "id": "c1", "label": "Concurrent 1 heeft dit ook", "default": false },
        { "type": "checkbox", "id": "c2", "label": "Concurrent 2 heeft dit ook", "default": false },
        { "type": "checkbox", "id": "c3", "label": "Concurrent 3 heeft dit ook", "default": false }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "text": "Volledig plasticvrij" } },
        { "type": "row", "settings": { "text": "Vlekverwijderende enzymen", "c1": true, "c2": true } },
        { "type": "row", "settings": { "text": "Plantaardig" } },
        { "type": "row", "settings": { "text": "Huidvriendelijke ingrediënten" } },
        { "type": "row", "settings": { "text": "Makkelijk te doseren", "c2": true } },
        { "type": "row", "settings": { "text": "Geld-terug-garantie" } },
        { "type": "row", "settings": { "text": "Licht & makkelijk mee te nemen" } },
        { "type": "row", "settings": { "text": "Steunt milieu-initiatieven" } }
      ]
    }
  ]
}
{% endschema %}
