        </span>
        <span class="tabblie-chero__hc-usp">
          <span class="tabblie-chero__hc-usp-icon">
            <svg viewBox="0 0 24 24" style="fill:none;stroke:#FFFFFF" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 20h10" style="fill:none"/><path d="M12 20V10" style="fill:none"/><path d="M12 10C12 6 9 4 5 4c0 4 2 6 7 6z" style="fill:none"/><path d="M12 13c0-3 2.5-5 6.5-5 0 3.5-2 5.5-6.5 5z" style="fill:none"/></svg>
