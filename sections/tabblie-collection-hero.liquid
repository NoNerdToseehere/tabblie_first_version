  </svg>
  <svg class="tabblie-chero__leaf tabblie-chero__leaf--2" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <circle cx="42" cy="54" r="33" fill="currentColor" opacity="0.35"/><circle cx="42" cy="54" r="33" fill="none" stroke="currentColor" stroke-width="3"/><path d="M22 46 A 23 23 0 0 1 33 31" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" opacity="0.9"/><circle cx="79" cy="28" r="13" fill="currentColor" opacity="0.35"/><circle cx="79" cy="28" r="13" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M71 25 A 9 9 0 0 1 75 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.9"/><circle cx="86" cy="68" r="6" fill="currentColor" opacity="0.55"/>
  </svg>
  <svg class="tabblie-chero__leaf tabblie-chero__leaf--3" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <circle cx="42" cy="54" r="33" fill="currentColor" opacity="0.35"/><circle cx="42" cy="54" r="33" fill="none" stroke="currentColor" stroke-width="3"/><path d="M22 46 A 23 23 0 0 1 33 31" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" opacity="0.9"/><circle cx="79" cy="28" r="13" fill="currentColor" opacity="0.35"/><circle cx="79" cy="28" r="13" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M71 25 A 9 9 0 0 1 75 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.9"/><circle cx="86" cy="68" r="6" fill="currentColor" opacity="0.55"/>
  </svg>
  <svg class="tabblie-chero__leaf tabblie-chero__leaf--4" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <circle cx="42" cy="54" r="33" fill="currentColor" opacity="0.35"/><circle cx="42" cy="54" r="33" fill="none" stroke="currentColor" stroke-width="3"/><path d="M22 46 A 23 23 0 0 1 33 31" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" opacity="0.9"/><circle cx="79" cy="28" r="13" fill="currentColor" opacity="0.35"/><circle cx="79" cy="28" r="13" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M71 25 A 9 9 0 0 1 75 19" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.9"/><circle cx="86" cy="68" r="6" fill="currentColor" opacity="0.55"/>
  </svg>
  <div class="tabblie-chero__inner">

    {%- if section.settings.badge_text != blank -%}
      <p class="tabblie-chero__badge">{{ section.settings.badge_text }}</p>
    {%- endif -%}

    <h2 class="tabblie-chero__heading">
      {{- section.settings.heading -}}
      {%- if section.settings.heading_accent != blank -%}
        <em class="tabblie-chero__accent"> {{ section.settings.heading_accent }}</em>
      {%- endif -%}
    </h2>

    {%- if section.settings.subtext != blank -%}
      <p class="tabblie-chero__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.hero_image_asset != blank and section.settings.button_text != blank -%}
      <a class="tabblie-chero__cta" href="{{ section.settings.button_url | default: '/collections/all' }}">
        {{ section.settings.button_text }}
        <svg width="20" height="20" style="width:20px;height:20px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="M12.5 6 18.5 12l-6 6"/></svg>
      </a>
    {%- endif -%}

  </div>

  {%- if section.settings.hero_image_asset == blank -%}
  <div class="tabblie-chero__cards-wrap">
    <div class="tabblie-chero__cards">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- assign card_url = block.settings.url | default: col.url | default: '#' -%}
        {%- assign card_label = block.settings.label | default: col.title | default: 'Shop now' -%}

        {%- if block.settings.coming_soon -%}
          <div class="tabblie-chero__card tabblie-chero__card--soon" {{ block.shopify_attributes }}>
        {%- else -%}
          <a class="tabblie-chero__card" href="{{ card_url }}" {{ block.shopify_attributes }}>
        {%- endif -%}
          <div class="tabblie-chero__card-img">
            {%- if block.settings.coming_soon -%}
              <span class="tabblie-chero__card-soon">Binnenkort</span>
              <span class="tabblie-chero__card-soon-mark" aria-hidden="true">?</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 480 }}"
                alt="{{ card_label | escape }}"
                width="480"
                height="640"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {%- elsif col.featured_image != blank -%}
              <img
                src="{{ col.featured_image | image_url: width: 480 }}"
                alt="{{ col.title | escape }}"
                width="480"
                height="640"
                loading="lazy"
              >
            {%- else -%}
              {%- assign label_lower = card_label | downcase -%}
              {%- if label_lower contains 'wasstrip' or label_lower contains 'laundry' -%}
                <img src="{{ 'tabblie-wasstrips.png' | asset_url }}" alt="{{ card_label | escape }}" width="480" height="640" loading="lazy">
              {%- elsif label_lower contains 'vaatwas' or label_lower contains 'dishwash' -%}
                <img src="{{ 'tabblie-vaatwasstrips.png' | asset_url }}" alt="{{ card_label | escape }}" width="480" height="640" loading="lazy">
              {%- elsif label_lower contains 'toilet' -%}
                <img src="{{ 'tabblie-toiletstrips.png' | asset_url }}" alt="{{ card_label | escape }}" width="480" height="640" loading="lazy">
              {%- elsif label_lower contains 'alles' or label_lower contains 'all-purpose' -%}
                <img src="{{ 'tabblie-allesreiniger.png' | asset_url }}" alt="{{ card_label | escape }}" width="480" height="640" loading="lazy">
              {%- else -%}
                <div class="tabblie-chero__card-placeholder"></div>
              {%- endif -%}
            {%- endif -%}
          </div>

          <div class="tabblie-chero__card-foot">
            <span class="tabblie-chero__card-label">{{ card_label }}</span>
            {%- unless block.settings.coming_soon -%}
              <span class="tabblie-chero__card-arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.75 9H14.25M10.5 5.25L14.25 9L10.5 12.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endunless -%}
          </div>
        {%- if block.settings.coming_soon -%}</div>{%- else -%}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.marquee_text != blank -%}
    {%- assign marquee_items = section.settings.marquee_text | split: '|' -%}
    <div class="tabblie-chero__marquee" aria-label="Voordelen">
      <div class="tabblie-chero__marquee-track">
        {%- for item in marquee_items -%}
          {%- assign item_lower = item | strip | downcase -%}
          <span class="tabblie-chero__marquee-item">
            <span class="tabblie-chero__marquee-badge">
              {%- if item_lower contains 'plastic' or item_lower contains 'pva' -%}
                <img src="{{ 'tabblie-stamp-microplasticvrij.png' | asset_url }}" alt="" width="48" height="48" loading="lazy">
              {%- elsif item_lower contains 'afbreekbaar' -%}
                <img src="{{ 'tabblie-stamp-afbreekbaar.png' | asset_url }}" alt="" width="48" height="48" loading="lazy">
              {%- elsif item_lower contains 'vegan' -%}
                <img src="{{ 'tabblie-stamp-vegan.png' | asset_url }}" alt="" width="48" height="48" loading="lazy">
              {%- elsif item_lower contains 'brievenbus' -%}
                <svg viewBox="0 0 24 24" style="fill:none;stroke:#182D20" fill="none" stroke="#182D20" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="12" rx="2" style="fill:none"/><path d="M3 12h18" style="fill:none"/><path d="M9 8V6a3 3 0 0 1 6 0v2" style="fill:none"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" style="fill:none;stroke:#182D20" fill="none" stroke="#182D20" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" style="fill:none"/></svg>
              {%- endif -%}
            </span>
            {{ item | strip }}
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    document.querySelectorAll('.tabblie-chero__hc-link[href="#zo-werkt-het"]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        var target = document.getElementById('zo-werkt-het');
        if (!target) return;
        e.preventDefault();
        var top = target.getBoundingClientRect().top + window.pageYOffset - 80;
        window.scrollTo({ top: top, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Hero",
  "tag": "section",
  "class": "tabblie-collection-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Join <strong>thousands</strong> cleaning smarter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean home,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (italic orange)",
      "default": "smarter for the planet."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "One strip replaces one plastic bottle. No waste, no compromise. Ships to NL & BE."
    },
    {
      "type": "text",
      "id": "hero_image_asset",
      "label": "Grote hero-afbeelding (asset bestandsnaam, vervangt de productkaarten)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "CTA tekst",
      "default": "Ontdek onze producten"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee strip (separate items with |)",
      "default": "No plastic waste | Ships to NL & BE | 100% vegan | No harsh chemicals | Super effective | Money-back guarantee"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Card label",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Leave blank to use collection URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Leave blank to use collection image"
        },
        {
          "type": "checkbox",
          "id": "coming_soon",
          "label": "Coming soon",
          "info": "Shows a 'Binnenkort' badge and disables the link",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Hero",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "label": "Laundry Strips"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "label": "Dishwasher Strips"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "label": "Toilet Strips"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "label": "All-Purpose"
          }
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
