{%- comment -%}
  tabblie-buy-feature.liquid
  Focused single-product buy block for the homepage (2026-07-28):
  packshot/lifestyle left, title + price + benefit checks + add-to-cart right.
  Pick the product in the section settings. Falls back gracefully.
{%- endcomment -%}

{%- assign product = section.settings.product -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign media_i = section.settings.media_index | default: 2 | minus: 1 -%}

<style>
  /* NB: background comes from an inline style, not this rule. Several
     instances of this section share one class name, so a Liquid-interpolated
     background here would let the last one on the page win for all of them. */
  .tabblie-buy {
    padding: clamp(48px, 6vw, 84px) clamp(16px, 3vw, 40px);
  }

  .tabblie-buy__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 68px);
    align-items: center;
  }

  .tabblie-buy__media {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: rgba(24, 45, 32, 0.04);
    position: relative;
  }

  .tabblie-buy__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  .tabblie-buy__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tabblie-buy__media-link:hover img { transform: scale(1.035); }

  .tabblie-buy__media-link:focus-visible {
    outline: 3px solid #E8622A;
    outline-offset: 3px;
  }

  .tabblie-buy__content {
    display: flex;
    flex-direction: column;
  }

  .tabblie-buy__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin-bottom: 14px;
  }

  .tabblie-buy__eyebrow::before,
  .tabblie-buy__eyebrow::after {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: #F08CAE;
    flex-shrink: 0;
  }
  .tabblie-buy__eyebrow::before { transform: rotate(8deg); }
  .tabblie-buy__eyebrow::after { transform: rotate(-8deg); }

  .tabblie-buy__title {
    font-family: var(--heading-font-family);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 800;
    color: #26523F;
    letter-spacing: -0.02em;
    line-height: 1.06;
    margin: 0 0 12px;
  }

  .tabblie-buy__price {
    font-family: var(--text-font-family);
    font-size: 26px;
    font-weight: 800;
    color: #182D20;
    margin: 0 0 20px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .tabblie-buy__price s {
    font-size: 18px;
    font-weight: 600;
    color: rgba(24, 45, 32, 0.5);
  }

  /* ── Social proof ── */
  .tabblie-buy__rating {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 12px;
  }

  .tabblie-buy__stars {
    display: inline-flex;
    gap: 2px;
    color: #E8622A;
  }

  .tabblie-buy__stars svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .tabblie-buy__rating-text {
    font-family: var(--text-font-family);
    font-size: 14px;
    font-weight: 700;
    color: #182D20;
  }

  .tabblie-buy__rating-text span {
    font-weight: 600;
    color: rgba(24, 45, 32, 0.6);
  }

  .tabblie-buy__review {
    margin: 0 0 22px;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.66);
    border-radius: 14px;
    border-left: 4px solid #E8622A;
  }

  .tabblie-buy__review blockquote {
    margin: 0;
    font-family: var(--text-font-family);
    font-size: 14.5px;
    font-style: italic;
    font-weight: 500;
    color: rgba(24, 45, 32, 0.85);
    line-height: 1.5;
  }

  .tabblie-buy__review figcaption {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 8px;
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 700;
    color: #182D20;
  }

  .tabblie-buy__review-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid #FFFFFF;
    box-shadow: 0 1px 4px rgba(24, 45, 32, 0.18);
  }

  .tabblie-buy__review-name { margin-right: auto; }

  .tabblie-buy__review-verified {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11.5px;
    font-weight: 700;
    color: #E8622A;
    white-space: nowrap;
  }

  .tabblie-buy__review-verified svg {
    width: 12px;
    height: 12px;
    fill: none;
  }

  .tabblie-buy__benefits {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .tabblie-buy__benefit {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--text-font-family);
    font-size: 15.5px;
    font-weight: 600;
    color: #182D20;
  }

  .tabblie-buy__check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #26523F;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tabblie-buy__check svg { width: 13px; height: 13px; }

  .tabblie-buy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .tabblie-buy__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    background: #E8622A;
    color: #FFFFFF !important;
    font-family: var(--text-font-family);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.01em;
    padding: 17px 38px;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .tabblie-buy__atc:hover {
    background: #cf531e;
    color: #FFFFFF !important;
    transform: translateY(-2px);
  }

  .tabblie-buy__atc svg { width: 22px; height: 22px; flex-shrink: 0; }

  .tabblie-buy__options {
    font-family: var(--text-font-family);
    font-size: 15px;
    font-weight: 800;
    color: #182D20 !important;
    text-decoration: none;
    border-bottom: 2.5px solid #26523F;
    padding-bottom: 3px;
  }

  /* Image side — alternates when several of these stack up. Mobile always
     leads with the image, so this only applies once side-by-side. */
  @media (min-width: 750px) {
    .tabblie-buy--reversed .tabblie-buy__media { order: 2; }
    .tabblie-buy--reversed .tabblie-buy__inner { grid-template-columns: 1fr 1fr; }
  }

  /* Compact — for stacking several of these in a row without the page
     running away. Smaller image, tighter type, less air. */
  .tabblie-buy--compact {
    padding: clamp(18px, 1.9vw, 26px) clamp(16px, 3vw, 40px);
  }

  .tabblie-buy--compact .tabblie-buy__inner {
    max-width: 940px;
    grid-template-columns: 0.78fr 1.22fr;
    gap: clamp(20px, 2.6vw, 38px);
  }

  /* the photo is the tallest thing in the row — capping it is what actually
     shortens the section */
  .tabblie-buy--compact .tabblie-buy__media {
    aspect-ratio: 1 / 1;
    max-height: 268px;
    max-width: 268px;
    margin-inline: auto;
  }

  .tabblie-buy--compact.tabblie-buy--reversed .tabblie-buy__inner {
    grid-template-columns: 1.15fr 0.85fr;
  }

  .tabblie-buy--compact .tabblie-buy__media { border-radius: 18px; }
  .tabblie-buy--compact .tabblie-buy__title { font-size: clamp(21px, 2.1vw, 28px); margin-bottom: 5px; }
  .tabblie-buy--compact .tabblie-buy__eyebrow { font-size: 11.5px; margin-bottom: 7px; }
  .tabblie-buy--compact .tabblie-buy__price { font-size: 20px; margin-bottom: 10px; }
  .tabblie-buy--compact .tabblie-buy__rating { margin-bottom: 7px; gap: 7px; }
  .tabblie-buy--compact .tabblie-buy__stars svg { width: 15px; height: 15px; }
  .tabblie-buy--compact .tabblie-buy__rating-text { font-size: 13px; }
  .tabblie-buy--compact .tabblie-buy__review { padding: 10px 13px; margin-bottom: 14px; border-radius: 12px; }
  .tabblie-buy--compact .tabblie-buy__review blockquote { font-size: 13px; line-height: 1.45; }
  .tabblie-buy--compact .tabblie-buy__review figcaption { margin-top: 6px; font-size: 12px; gap: 3px 8px; }
  .tabblie-buy--compact .tabblie-buy__review-avatar { width: 28px; height: 28px; }
  .tabblie-buy--compact .tabblie-buy__benefits { gap: 6px; margin-bottom: 15px; }
  .tabblie-buy--compact .tabblie-buy__benefit { font-size: 13.5px; gap: 9px; }
  .tabblie-buy--compact .tabblie-buy__check { width: 19px; height: 19px; }
  .tabblie-buy--compact .tabblie-buy__check svg { width: 10px; height: 10px; }
  .tabblie-buy--compact .tabblie-buy__actions { gap: 10px 16px; }
  .tabblie-buy--compact .tabblie-buy__atc { font-size: 15px; padding: 12px 26px; }
  .tabblie-buy--compact .tabblie-buy__atc svg { width: 17px; height: 17px; }
  .tabblie-buy--compact .tabblie-buy__options { font-size: 14px; }

  @media (max-width: 749px) {
    .tabblie-buy__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tabblie-buy__media {
      aspect-ratio: 1 / 1;
    }

    .tabblie-buy__atc {
      width: 100%;
    }

    .tabblie-buy--compact { padding: 26px 16px; }
    .tabblie-buy--compact .tabblie-buy__inner { grid-template-columns: 1fr; gap: 16px; }
    /* a tall photo per product is a lot of scrolling on a phone */
    .tabblie-buy--compact .tabblie-buy__media { aspect-ratio: 1 / 1; max-height: 240px; max-width: 240px; }
  }
</style>

{%- if section.settings.anchor_id != blank -%}
  <div id="{{ section.settings.anchor_id | handle }}" aria-hidden="true" style="display:block;height:1px;margin-top:-1px;scroll-margin-top:90px"></div>
{%- endif -%}
<section class="tabblie-buy{% if section.settings.compact %} tabblie-buy--compact{% endif %}{% if section.settings.image_side == 'right' %} tabblie-buy--reversed{% endif %}" id="tabblie-buy-{{ section.id }}" style="background-color: {{ section.settings.bg_color | default: '#E2F2ED' }}">
  <div class="tabblie-buy__inner">

    <div class="tabblie-buy__media">
      {%- if product != blank -%}
        <a class="tabblie-buy__media-link" href="{{ product.url }}" aria-label="{{ product.title | escape }} bekijken">
      {%- endif -%}
      {%- assign chosen = product.media[media_i] -%}
      {%- if chosen != blank -%}
        <img src="{{ chosen.preview_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="1000" loading="lazy">
      {%- elsif section.settings.image_asset != blank -%}
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ product.title | default: 'Tabblie' | escape }}" width="900" height="675" loading="lazy">
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ product.title | default: 'Tabblie' | escape }}" width="900" height="675" loading="lazy">
      {%- elsif product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="675" loading="lazy">
      {%- else -%}
        <img src="{{ 'tabblie-wasstrips.png' | asset_url }}" alt="Tabblie Wasstrips" width="900" height="675" loading="lazy">
      {%- endif -%}
      {%- if product != blank -%}</a>{%- endif -%}
    </div>

    <div class="tabblie-buy__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tabblie-buy__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="tabblie-buy__title">{{ section.settings.title | default: product.title | default: 'Tabblie Wasstrips' }}</h2>

      {%- if section.settings.rating != blank -%}
        <div class="tabblie-buy__rating">
          <span class="tabblie-buy__stars" role="img" aria-label="{{ section.settings.rating }} van de 5 sterren">
            {%- assign rating_num = section.settings.rating | times: 1.0 -%}
            {%- for i in (1..5) -%}
              {%- assign remaining = rating_num | minus: forloop.index0 -%}
              {%- if remaining >= 1 -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.35 6.19 20.4l1.11-6.47L2.6 9.35l6.5-.95z"/></svg>
              {%- elsif remaining > 0 -%}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <defs><linearGradient id="tbhalf-{{ section.id }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs>
                  <path d="M12 2.5l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.35 6.19 20.4l1.11-6.47L2.6 9.35l6.5-.95z" fill="url(#tbhalf-{{ section.id }})" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.35 6.19 20.4l1.11-6.47L2.6 9.35l6.5-.95z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="tabblie-buy__rating-text">
            {{ section.settings.rating }}/5
            {%- if section.settings.rating_count != blank -%}
              {{ ' ' }}<span>· {{ section.settings.rating_count }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- if product != blank -%}
        <p class="tabblie-buy__price">
          {%- if variant.compare_at_price > variant.price -%}
            <span>{{ variant.price | money }}</span>
            <s>{{ variant.compare_at_price | money }}</s>
          {%- else -%}
            <span>{{ variant.price | money }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="tabblie-buy__benefits">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="tabblie-buy__benefit" {{ block.shopify_attributes }}>
                <span class="tabblie-buy__check" aria-hidden="true">
                  <svg viewBox="0 0 256 256" fill="#ffffff" style="fill:#ffffff"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/></svg>
                </span>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.review_quote != blank -%}
        <figure class="tabblie-buy__review">
          <blockquote>{{ section.settings.review_quote }}</blockquote>
          {%- if section.settings.review_author != blank -%}
            <figcaption>
              {%- if section.settings.review_avatar != blank -%}
                <img class="tabblie-buy__review-avatar"
                     src="{{ section.settings.review_avatar | image_url: width: 96 }}"
                     alt=""
                     width="36" height="36" loading="lazy">
              {%- elsif section.settings.review_avatar_asset != blank -%}
                <img class="tabblie-buy__review-avatar"
                     src="{{ section.settings.review_avatar_asset | asset_url }}"
                     alt=""
                     width="36" height="36" loading="lazy">
              {%- endif -%}
              <span class="tabblie-buy__review-name">{{ section.settings.review_author }}</span>
              <span class="tabblie-buy__review-verified">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5"/></svg>
                Geverifieerd
              </span>
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}

      <div class="tabblie-buy__actions">
        {%- if product != blank and variant != blank -%}
          <form action="{{ routes.cart_url }}/add" method="post" enctype="multipart/form-data" data-type="add-to-cart-form">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <button type="submit" name="add" class="tabblie-buy__atc" data-btn-addToCart>
              <svg viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true" style="fill:#ffffff"><path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM7.2 14.6l.1-.1L8.1 13h7.4c.75 0 1.4-.4 1.7-1l3.6-6.5-1.7-1H19L15.5 11H8.5L4.3 2H1v2h2l3.6 7.6-1.35 2.45C4.5 15.4 5.5 17 7 17h12v-2H7.4c-.15 0-.25-.1-.2-.4z"/></svg>
              {{ section.settings.button_text | default: 'In winkelwagen' }}
            </button>
          </form>
          <a class="tabblie-buy__options" href="{{ product.url }}">Meer informatie</a>
        {%- else -%}
          <a class="tabblie-buy__atc" href="{{ section.settings.button_url | default: '/collections/all' }}">{{ section.settings.button_text | default: 'Ontdek de strips' }}</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Tabblie Buy Feature",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "number", "id": "media_index", "label": "Productfoto nummer (1 = eerste galerijfoto)", "info": "Gebruikt dezelfde foto als op de productpagina" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (optioneel, anders productfoto)" },
    { "type": "text", "id": "image_asset", "label": "Afbeelding uit theme assets (bestandsnaam)", "info": "Bijv. tabblie-product-feature.png — heeft voorrang" },
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#E2F2ED" },
    { "type": "checkbox", "id": "compact", "label": "Compacte weergave", "info": "Kleiner blok — gebruik dit als er meerdere productblokken onder elkaar staan.", "default": false },
    { "type": "select", "id": "image_side", "label": "Afbeelding aan", "options": [ { "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" } ], "default": "left" },
    { "type": "text", "id": "anchor_id", "label": "Anker-id", "info": "Maakt deze sectie linkbaar, bijv. 'tabblie-strips' → link ernaartoe met #tabblie-strips." },
    { "type": "header", "content": "Social proof" },
    { "type": "text", "id": "rating", "label": "Beoordeling (0-5)", "info": "Moet de échte gemiddelde score zijn — verzonnen scores zijn in de EU verboden. Leeg = geen sterren." },
    { "type": "text", "id": "rating_count", "label": "Aantal beoordelingen", "info": "Bijv. '128 reviews'. Leeg = alleen de score." },
    { "type": "textarea", "id": "review_quote", "label": "Review citaat", "info": "Alleen een echte, herleidbare klantreview." },
    { "type": "text", "id": "review_author", "label": "Naam klant", "info": "Bijv. 'Lisa B. — Amsterdam'" },
    { "type": "image_picker", "id": "review_avatar", "label": "Foto klant" },
    { "type": "text", "id": "review_avatar_asset", "label": "Foto klant uit theme assets", "info": "Bestandsnaam, bijv. tabblie-avatar-lisa.jpg. Alleen gebruikt als hierboven geen foto is gekozen." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MEEST GEKOZEN" },
    { "type": "text", "id": "title", "label": "Titel (leeg = productnaam)" },
    { "type": "text", "id": "button_text", "label": "Knop tekst", "default": "In winkelwagen" },
    { "type": "url", "id": "button_url", "label": "Fallback-link (als geen product gekozen)" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Voordeel",
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabblie Buy Feature",
      "blocks": [
        { "type": "benefit", "settings": { "text": "32 strips — goed voor 64 wasbeurten" } },
        { "type": "benefit", "settings": { "text": "Vervangt tot 60 plastic flessen per jaar" } },
        { "type": "benefit", "settings": { "text": "100% plastic- & microplasticvrij" } },
        { "type": "benefit", "settings": { "text": "Gratis verzending, morgen in huis" } }
      ]
    }
  ]
}
{% endschema %}
