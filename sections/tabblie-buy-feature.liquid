{%- comment -%}
  tabblie-buy-feature.liquid
  Focused single-product buy block for the homepage (2026-07-28):
  packshot/lifestyle left, title + price + benefit checks + add-to-cart right.
  Pick the product in the section settings. Falls back gracefully.
{%- endcomment -%}

{%- assign product = section.settings.product -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign media_i = section.settings.media_index | default: 2 | minus: 1 -%}

<style>
  .tabblie-buy {
    background-color: {{ section.settings.bg_color | default: '#E2F2ED' }};
    padding: clamp(48px, 6vw, 84px) clamp(16px, 3vw, 40px);
  }

  .tabblie-buy__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 68px);
    align-items: center;
  }

  .tabblie-buy__media {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: rgba(24, 45, 32, 0.04);
    position: relative;
  }

  .tabblie-buy__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tabblie-buy__content {
    display: flex;
    flex-direction: column;
  }

  .tabblie-buy__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin-bottom: 14px;
  }

  .tabblie-buy__eyebrow::before,
  .tabblie-buy__eyebrow::after {
    content: '';
    width: 22px;
    height: 3px;
    border-radius: 3px;
    background: #F08CAE;
    flex-shrink: 0;
  }
  .tabblie-buy__eyebrow::before { transform: rotate(8deg); }
  .tabblie-buy__eyebrow::after { transform: rotate(-8deg); }

  .tabblie-buy__title {
    font-family: var(--heading-font-family);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 800;
    color: #26523F;
    letter-spacing: -0.02em;
    line-height: 1.06;
    margin: 0 0 12px;
  }

  .tabblie-buy__price {
    font-family: var(--text-font-family);
    font-size: 26px;
    font-weight: 800;
    color: #182D20;
    margin: 0 0 20px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .tabblie-buy__price s {
    font-size: 18px;
    font-weight: 600;
    color: rgba(24, 45, 32, 0.5);
  }

  .tabblie-buy__benefits {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .tabblie-buy__benefit {
    display: flex;
    align-items: center;
    gap: 11px;
    font-family: var(--text-font-family);
    font-size: 15.5px;
    font-weight: 600;
    color: #182D20;
  }

  .tabblie-buy__check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #26523F;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .tabblie-buy__check svg { width: 13px; height: 13px; }

  .tabblie-buy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .tabblie-buy__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    background: #E8622A;
    color: #FFFFFF !important;
    font-family: var(--text-font-family);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.01em;
    padding: 17px 38px;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .tabblie-buy__atc:hover {
    background: #cf531e;
    color: #FFFFFF !important;
    transform: translateY(-2px);
  }

  .tabblie-buy__atc svg { width: 22px; height: 22px; flex-shrink: 0; }

  .tabblie-buy__options {
    font-family: var(--text-font-family);
    font-size: 15px;
    font-weight: 800;
    color: #182D20 !important;
    text-decoration: none;
    border-bottom: 2.5px solid #26523F;
    padding-bottom: 3px;
  }

  @media (max-width: 749px) {
    .tabblie-buy__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .tabblie-buy__media {
      aspect-ratio: 1 / 1;
    }

    .tabblie-buy__atc {
      width: 100%;
    }
  }
</style>

<section class="tabblie-buy" id="tabblie-buy-{{ section.id }}">
  <div class="tabblie-buy__inner">

    <div class="tabblie-buy__media">
      {%- assign chosen = product.media[media_i] -%}
      {%- if chosen != blank -%}
        <img src="{{ chosen.preview_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" width="1000" height="1000" loading="lazy">
      {%- elsif section.settings.image_asset != blank -%}
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ product.title | default: 'Tabblie' | escape }}" width="900" height="675" loading="lazy">
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ product.title | default: 'Tabblie' | escape }}" width="900" height="675" loading="lazy">
      {%- elsif product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="675" loading="lazy">
      {%- else -%}
        <img src="{{ 'tabblie-wasstrips.png' | asset_url }}" alt="Tabblie Wasstrips" width="900" height="675" loading="lazy">
      {%- endif -%}
    </div>

    <div class="tabblie-buy__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tabblie-buy__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="tabblie-buy__title">{{ section.settings.title | default: product.title | default: 'Tabblie Wasstrips' }}</h2>

      {%- if product != blank -%}
        <p class="tabblie-buy__price">
          {%- if variant.compare_at_price > variant.price -%}
            <span>{{ variant.price | money }}</span>
            <s>{{ variant.compare_at_price | money }}</s>
          {%- else -%}
            <span>{{ variant.price | money }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="tabblie-buy__benefits">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="tabblie-buy__benefit" {{ block.shopify_attributes }}>
                <span class="tabblie-buy__check" aria-hidden="true">
                  <svg viewBox="0 0 256 256" fill="#ffffff" style="fill:#ffffff"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/></svg>
                </span>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="tabblie-buy__actions">
        {%- if product != blank and variant != blank -%}
          <form action="{{ routes.cart_url }}/add" method="post" enctype="multipart/form-data" data-type="add-to-cart-form">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <button type="submit" name="add" class="tabblie-buy__atc" data-btn-addToCart>
              <svg viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true" style="fill:#ffffff"><path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM7.2 14.6l.1-.1L8.1 13h7.4c.75 0 1.4-.4 1.7-1l3.6-6.5-1.7-1H19L15.5 11H8.5L4.3 2H1v2h2l3.6 7.6-1.35 2.45C4.5 15.4 5.5 17 7 17h12v-2H7.4c-.15 0-.25-.1-.2-.4z"/></svg>
              {{ section.settings.button_text | default: 'In winkelwagen' }}
            </button>
          </form>
          <a class="tabblie-buy__options" href="{{ product.url }}">Meer informatie</a>
        {%- else -%}
          <a class="tabblie-buy__atc" href="{{ section.settings.button_url | default: '/collections/all' }}">{{ section.settings.button_text | default: 'Ontdek de strips' }}</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Tabblie Buy Feature",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "number", "id": "media_index", "label": "Productfoto nummer (1 = eerste galerijfoto)", "info": "Gebruikt dezelfde foto als op de productpagina" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (optioneel, anders productfoto)" },
    { "type": "text", "id": "image_asset", "label": "Afbeelding uit theme assets (bestandsnaam)", "info": "Bijv. tabblie-product-feature.png — heeft voorrang" },
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#E2F2ED" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MEEST GEKOZEN" },
    { "type": "text", "id": "title", "label": "Titel (leeg = productnaam)" },
    { "type": "text", "id": "button_text", "label": "Knop tekst", "default": "In winkelwagen" },
    { "type": "url", "id": "button_url", "label": "Fallback-link (als geen product gekozen)" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Voordeel",
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabblie Buy Feature",
      "blocks": [
        { "type": "benefit", "settings": { "text": "32 strips — goed voor 64 wasbeurten" } },
        { "type": "benefit", "settings": { "text": "Vervangt tot 60 plastic flessen per jaar" } },
        { "type": "benefit", "settings": { "text": "100% plastic- & microplasticvrij" } },
        { "type": "benefit", "settings": { "text": "Gratis verzending, morgen in huis" } }
      ]
    }
  ]
}
{% endschema %}
