{%- comment -%}
  tabblie-how-it-works-v2.liquid
  Single-card stepper: numbered nodes with filling progress bars.
  Auto-advances 1 → 2 → 3 when scrolled into view, stays on the final step.
{%- endcomment -%}

<style>
  .tabblie-hiw2 {
    background: linear-gradient(135deg, #F8BFD6 0%, #FADCE8 50%, #FDF0E8 100%);
    padding: clamp(56px, 7vw, 96px) clamp(16px, 3vw, 40px);
    position: relative;
    overflow: hidden;
  }

  .tabblie-hiw2::before {
    content: '1 2 3';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading-family);
    font-size: clamp(14rem, 22vw, 22rem);
    font-weight: 800;
    color: rgba(255, 255, 255, 0.12);
    letter-spacing: 0.15em;
    white-space: nowrap;
    pointer-events: none;
  }

  .tabblie-hiw2__inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .tabblie-hiw2__header {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .tabblie-hiw2__eyebrow {
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin-bottom: 14px;
  }

  .tabblie-hiw2__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: var(--font-heading-weight);
    color: #1F1209;
    line-height: 1.1;
    margin: 0;
  }

  /* ── Single stepper card ── */
  .tabblie-hiw2__panel {
    background: #ffffff;
    border-radius: 24px;
    padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 56px);
    max-width: 640px;
    margin: 0 auto;
    box-shadow: 0 12px 40px rgba(31, 18, 9, 0.08);
  }

  /* track: nodes + connecting bars */
  .tabblie-hiw2__track {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(24px, 3vw, 32px);
  }

  .tabblie-hiw2__node {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid rgba(232, 98, 42, 0.3);
    background: #ffffff;
    color: rgba(31, 18, 9, 0.4);
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .tabblie-hiw2__node-check {
    display: none;
    width: 18px;
    height: 18px;
  }

  .tabblie-hiw2__node--active {
    background: #E8622A;
    border-color: #E8622A;
    color: #ffffff;
    transform: scale(1.1);
    box-shadow: 0 6px 18px rgba(232, 98, 42, 0.35);
  }

  .tabblie-hiw2__node--done {
    background: #38A169;
    border-color: #38A169;
    color: #ffffff;
  }

  .tabblie-hiw2__node--done .tabblie-hiw2__node-num {
    display: none;
  }

  .tabblie-hiw2__node--done .tabblie-hiw2__node-check {
    display: block;
  }

  .tabblie-hiw2__bar {
    flex: 1;
    height: 5px;
    border-radius: 100px;
    background: rgba(232, 98, 42, 0.15);
    overflow: hidden;
  }

  .tabblie-hiw2__bar-fill {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: 100px;
    background: #E8622A;
  }

  .tabblie-hiw2__bar-fill--filling {
    transition: width var(--hiw-step-ms, 1800ms) linear;
    width: 100%;
  }

  .tabblie-hiw2__bar-fill--full {
    width: 100%;
  }

  /* step content */
  .tabblie-hiw2__contents {
    display: grid;
    text-align: center;
  }

  .tabblie-hiw2__content {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
    visibility: hidden;
  }

  .tabblie-hiw2__content--active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  .tabblie-hiw2__step-title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    font-weight: 600;
    color: #1F1209;
    margin: 0 0 10px;
  }

  .tabblie-hiw2__step-desc {
    font-family: var(--text-font-family);
    font-size: 15px;
    color: rgba(31, 18, 9, 0.65);
    line-height: 1.65;
    max-width: 420px;
    margin: 0 auto;
  }

  @media (max-width: 749px) {
    .tabblie-hiw2__panel {
      padding: 24px 20px 28px;
    }

    .tabblie-hiw2__node {
      width: 44px;
      height: 44px;
    }

    .tabblie-hiw2__track {
      gap: 8px;
    }

    .tabblie-hiw2__step-desc {
      font-size: 14px;
    }

    .tabblie-hiw2__contents {
      min-height: 96px;
    }

    .tabblie-hiw2::before {
      font-size: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tabblie-hiw2__node,
    .tabblie-hiw2__bar-fill,
    .tabblie-hiw2__content {
      transition: none !important;
    }
  }
</style>

<section class="tabblie-hiw2" id="tabblie-hiw2-{{ section.id }}">
  <div class="tabblie-hiw2__inner">

    <div class="tabblie-hiw2__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="tabblie-hiw2__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="tabblie-hiw2__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="tabblie-hiw2__panel" data-hiw-panel data-hiw-step-ms="1800">
      <div class="tabblie-hiw2__track">
        {%- for block in section.blocks -%}
          <button type="button" class="tabblie-hiw2__node" data-hiw-node="{{ forloop.index0 }}" aria-label="Stap {{ forloop.index }}: {{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
            <span class="tabblie-hiw2__node-num">{{ forloop.index }}</span>
            <svg class="tabblie-hiw2__node-check" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"/></svg>
          </button>
          {%- unless forloop.last -%}
            <span class="tabblie-hiw2__bar"><span class="tabblie-hiw2__bar-fill" data-hiw-bar="{{ forloop.index0 }}"></span></span>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="tabblie-hiw2__contents">
        {%- for block in section.blocks -%}
          <div class="tabblie-hiw2__content" data-hiw-content="{{ forloop.index0 }}">
            {%- if block.settings.title != blank -%}
              <h3 class="tabblie-hiw2__step-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="tabblie-hiw2__step-desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  var panel = document.querySelector('[data-hiw-panel]');
  if (!panel) return;

  var nodes = panel.querySelectorAll('[data-hiw-node]');
  var bars = panel.querySelectorAll('[data-hiw-bar]');
  var contents = panel.querySelectorAll('[data-hiw-content]');
  var total = nodes.length;
  if (!total) return;

  var stepMs = parseInt(panel.getAttribute('data-hiw-step-ms'), 10) || 2600;
  var timer = null;
  var current = -1;
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setStep(index) {
    current = index;
    nodes.forEach(function (node, i) {
      node.classList.toggle('tabblie-hiw2__node--active', i === index);
      node.classList.toggle('tabblie-hiw2__node--done', i < index);
    });
    bars.forEach(function (bar, i) {
      bar.classList.remove('tabblie-hiw2__bar-fill--filling');
      bar.classList.toggle('tabblie-hiw2__bar-fill--full', i < index);
      if (i >= index) {
        bar.style.width = '';
      }
    });
    contents.forEach(function (content, i) {
      content.classList.toggle('tabblie-hiw2__content--active', i === index);
    });
  }

  function advanceFrom(index) {
    if (index >= total - 1) return;
    var bar = bars[index];
    if (bar) {
      // force reflow so the width transition restarts cleanly
      void bar.offsetWidth;
      bar.classList.add('tabblie-hiw2__bar-fill--filling');
    }
    timer = setTimeout(function () {
      setStep(index + 1);
      advanceFrom(index + 1);
    }, stepMs);
  }

  function startSequence() {
    if (reduceMotion) {
      setStep(total - 1);
      return;
    }
    setStep(0);
    advanceFrom(0);
  }

  nodes.forEach(function (node, i) {
    node.addEventListener('click', function () {
      if (timer) { clearTimeout(timer); timer = null; }
      setStep(i);
    });
  });

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        startSequence();
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.35 });

  var rect = panel.getBoundingClientRect();
  if (rect.top < window.innerHeight && rect.bottom > 0) {
    startSequence();
  } else {
    observer.observe(panel);
  }
})();
</script>

{% schema %}
{
  "name": "How It Works v2",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Zo werkt het" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Drie stappen naar een schoner huis." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Step title", "default": "Scheur" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Scheur één strip van de verpakking." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works v2",
      "blocks": [
        { "type": "step", "settings": { "title": "Scheur", "description": "Scheur één strip van de verpakking. Geen afmeten, geen rommel, geen plastic fles." } },
        { "type": "step", "settings": { "title": "Gooi", "description": "Gooi de strip in de wasmachine, vaatwasser of los op in water. Het lost volledig op." } },
        { "type": "step", "settings": { "title": "Klaar. Echt waar.", "description": "Schone was, stralende vaat, een schoner huis — zonder plastic afval en zonder gedoe. Zo simpel kan het zijn." } }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
