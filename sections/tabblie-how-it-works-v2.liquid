{%- comment -%}
  tabblie-how-it-works-v2.liquid
  "Zo werkt het" — rebrand 2026-07-28: cream strip with hand-drawn step
  illustrations (assets tabblie-step-*.png), heading with a hand-drawn pink
  underline under the accent word, thin dividers between the three steps.
{%- endcomment -%}

<style>
  .tabblie-hiw2 {
    background: #FDF6EE;
    padding: clamp(56px, 7vw, 96px) clamp(16px, 3vw, 40px);
    position: relative;
    overflow: hidden;
  }

  .tabblie-hiw2__inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .tabblie-hiw2__eyebrow {
    display: flex !important;
    justify-content: center;
    font-family: var(--text-font-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E8622A;
    margin: 0 0 10px;
  }

  .tabblie-hiw2__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #182D20;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-align: center;
    margin: 0 0 clamp(36px, 5vw, 60px);
  }

  .tabblie-hiw2__accent {
    position: relative;
    white-space: nowrap;
  }

  .tabblie-hiw2__accent svg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    width: 100%;
    height: 10px;
  }

  .tabblie-hiw2__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .tabblie-hiw2__step {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 1.6vw, 22px);
    padding: 0 clamp(12px, 2vw, 32px);
  }

  .tabblie-hiw2__step + .tabblie-hiw2__step {
    border-left: 1.5px solid rgba(24, 45, 32, 0.14);
  }

  .tabblie-hiw2__step-art {
    flex-shrink: 0;
    width: clamp(120px, 11vw, 170px);
  }

  .tabblie-hiw2__step-art img {
    width: 100%;
    height: auto;
    display: block;
  }

  .tabblie-hiw2__step-num {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #E8622A;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading-family);
    font-size: 26px;
    font-weight: 800;
  }

  .tabblie-hiw2__step-copy {
    min-width: 0;
  }

  .tabblie-hiw2__step-title {
    font-family: var(--text-font-family);
    font-size: clamp(16px, 1.4vw, 19px);
    font-weight: 800;
    color: #182D20;
    line-height: 1.25;
    margin: 0 0 6px;
  }

  .tabblie-hiw2__step-desc {
    font-family: var(--text-font-family);
    font-size: clamp(13.5px, 1.1vw, 15px);
    font-weight: 500;
    color: rgba(24, 45, 32, 0.65);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 899px) {
    .tabblie-hiw2__steps {
      grid-template-columns: 1fr;
      row-gap: 26px;
      max-width: 440px;
      margin: 0 auto;
    }

    .tabblie-hiw2__step {
      justify-content: flex-start;
      padding: 0;
    }

    .tabblie-hiw2__step + .tabblie-hiw2__step {
      border-left: none;
      border-top: 1.5px solid rgba(24, 45, 32, 0.14);
      padding-top: 26px;
    }

    .tabblie-hiw2__step-art {
      width: 116px;
    }
  }
</style>

<div id="zo-werkt-het" aria-hidden="true" style="display:block !important;height:1px;margin-top:-1px;scroll-margin-top:90px"></div>
<section class="tabblie-hiw2" id="tabblie-hiw2-{{ section.id }}">
  <div class="tabblie-hiw2__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="tabblie-hiw2__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      {%- assign accent = section.settings.title_accent_word -%}
      <h2 class="tabblie-hiw2__title">
        {%- if accent != blank and section.settings.title contains accent -%}
          {%- capture accent_html -%}<span class="tabblie-hiw2__accent">{{ accent }}<svg viewBox="0 0 80 10" fill="none" preserveAspectRatio="none" aria-hidden="true"><path d="M3 7 C 25 2, 55 2, 77 6" stroke="#E8879F" stroke-width="3.5" stroke-linecap="round" style="fill:none"/></svg></span>{%- endcapture -%}
          {{ section.settings.title | replace_first: accent, accent_html }}
        {%- else -%}
          {{ section.settings.title }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tabblie-hiw2__steps">
        {%- for block in section.blocks -%}
          <div class="tabblie-hiw2__step" {{ block.shopify_attributes }}>
            {%- if block.settings.image_asset != blank -%}
              <div class="tabblie-hiw2__step-art">
                <img src="{{ block.settings.image_asset | asset_url }}" alt="" width="340" height="270" loading="lazy">
              </div>
            {%- else -%}
              <div class="tabblie-hiw2__step-num" aria-hidden="true">{{ forloop.index }}</div>
            {%- endif -%}
            <div class="tabblie-hiw2__step-copy">
              {%- if block.settings.title != blank -%}
                <h3 class="tabblie-hiw2__step-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="tabblie-hiw2__step-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Tabblie How It Works v2",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optioneel)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Kleine strips. Een groot verschil in je routine."
    },
    {
      "type": "text",
      "id": "title_accent_word",
      "label": "Woord met roze onderstreping",
      "default": "groot"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "text", "id": "description", "label": "Beschrijving" },
        { "type": "text", "id": "image_asset", "label": "Illustratie (asset bestandsnaam)", "info": "Bijv. tabblie-step-pak.png — leeg = oranje nummer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabblie How It Works v2",
      "blocks": [
        { "type": "step", "settings": { "title": "1. Pak een strip", "description": "Simpel, schoon en zonder geknoei.", "image_asset": "tabblie-step-pak.png" } },
        { "type": "step", "settings": { "title": "2. Gooi 'm erin", "description": "In de trommel bij je was.", "image_asset": "tabblie-step-gooi.png" } },
        { "type": "step", "settings": { "title": "3. Klaar. Echt waar.", "description": "Frisse was, elke keer weer.", "image_asset": "tabblie-step-klaar.png" } }
      ]
    }
  ]
}
{% endschema %}
