{% doc %}
  Matisse-style plant cutout for section corners (2026-07 homepage design).
  Fat rounded finger-lobes fanning out of a low mound — traced from the
  founder-approved reference crop (deep green on transparent, no background).

  @param color - fill color (default: dark green #26523F)
  @param width - CSS width (default: 180px)
  @param flip - set to true to mirror horizontally

  @example
  {% render 'tabblie-plant', color: '#26523F', width: '220px', flip: true %}
{% enddoc %}

{%- assign plant_color = color | default: '#26523F' -%}
{%- assign plant_width = width | default: '180px' -%}

<svg
  viewBox="0 0 240 210"
  fill="{{ plant_color }}"
  aria-hidden="true"
  style="display:block;width:{{ plant_width }};height:auto;fill:{{ plant_color }};{% if flip %}transform:scaleX(-1);{% endif %}"
>
  <!-- fat rounded lobes with clear gaps, fanning out of the mound -->
  <ellipse cx="48" cy="112" rx="23" ry="70" transform="rotate(-18 48 112)" style="fill:{{ plant_color }}"/>
  <ellipse cx="114" cy="76" rx="25" ry="92" transform="rotate(2 114 76)" style="fill:{{ plant_color }}"/>
  <ellipse cx="176" cy="108" rx="21" ry="64" transform="rotate(24 176 108)" style="fill:{{ plant_color }}"/>
  <ellipse cx="216" cy="150" rx="13" ry="30" transform="rotate(48 216 150)" style="fill:{{ plant_color }}"/>
  <!-- low wide base mound (extends past bottom edge, reads as a cutout) -->
  <ellipse cx="110" cy="222" rx="76" ry="60" style="fill:{{ plant_color }}"/>
</svg>
