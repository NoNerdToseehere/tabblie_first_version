{% doc %}
  Renders green checkmark benefit list for product pages.
  Pass style param to switch between templates.

  @param {string} [style] - "default", "eab", "mea", "toilet", or "vaat"

  @example
  {% render 'tabblie-benefit-checks', style: 'default' %}
{% enddoc %}

{%- comment -%}
  Checks are brand dark green on every product page. The toilet/mea pages
  used to swap in their identity colour, which made them the odd ones out.
{%- endcomment -%}
{%- assign check_color = '#26523F' -%}

{%- capture check_span -%}
<span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:{{ check_color }};margin-right:8px;flex-shrink:0;vertical-align:middle"><svg width="12" height="12" viewBox="0 0 256 256" fill="#ffffff" style="display:block;width:12px;height:12px;fill:#ffffff"><path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z" stroke="#ffffff" stroke-width="10"/></svg></span>
{%- endcapture -%}

<div style="font-size:14px;line-height:2.2;color:#182D20">
  {%- if style == 'vaat' -%}
    {{ check_span }}Streeploos schoon, ook bij hard water<br>
    {{ check_span }}Werkt in elke vaatwasser, ook op eco<br>
    {{ check_span }}100% biologisch afbreekbaar — zonder PVA-folie<br>
    {{ check_span }}Geen plastic wikkels of zware flessen meer
  {%- elsif style == 'toilet' -%}
    {{ check_span }}Fris en schoon zonder chloor of bleek<br>
    {{ check_span }}Veilig voor afvoer en septic tank<br>
    {{ check_span }}100% biologisch afbreekbaar<br>
    {{ check_span }}Geen plastic flessen of blokjeshouders meer
  {%- elsif style == 'mea' -%}
    {{ check_span }}Krachtige reiniging op plantbasis<br>
    {{ check_span }}Verpakt in recyclebaar papier — geen plasticafval<br>
    {{ check_span }}Geschikt voor alle wasmachines & textiel<br>
    {{ check_span }}Dermatologisch getest voor het hele gezin
  {%- elsif style == 'eab' -%}
    {{ check_span }}32 wasbeurten per pak<br>
    {{ check_span }}Vervangt tot 60 plastic flessen per jaar<br>
    {{ check_span }}100% biologisch afbreekbaar<br>
    {{ check_span }}Geschikt voor alle wasmachines & temperaturen<br>
    {{ check_span }}Dermatologisch getest, veilig voor het hele gezin
  {%- else -%}
    {{ check_span }}Vervangt tot 60 plastic flessen per jaar<br>
    {{ check_span }}100% biologisch afbreekbaar<br>
    {{ check_span }}Geschikt voor alle wasmachines & temperaturen<br>
    {{ check_span }}Dermatologisch getest, veilig voor het hele gezin
  {%- endif -%}
</div>
