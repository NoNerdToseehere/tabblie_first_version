{% doc %}
  Renders green checkmark benefit list for product pages.
  Pass style param to switch between templates.

  @param {string} [style] - "default", "eab", or "mea"

  @example
  {% render 'tabblie-benefit-checks', style: 'default' %}
{% enddoc %}

{%- assign check_color = '#38A169' -%}
{%- if style == 'mea' -%}
  {%- assign check_color = '#5BB8A0' -%}
{%- endif -%}

{%- capture check_span -%}
<span style="display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:{{ check_color }};color:#fff;font-size:12px;font-weight:700;margin-right:8px;flex-shrink:0;vertical-align:middle">&#10003;</span>
{%- endcapture -%}

<div style="font-size:14px;line-height:2.2;color:#1F1209">
  {%- if style == 'mea' -%}
    {{ check_span }}Krachtige reiniging op plantbasis<br>
    {{ check_span }}Verpakt in recyclebaar papier — geen plasticafval<br>
    {{ check_span }}Geschikt voor alle wasmachines & textiel<br>
    {{ check_span }}Dermatologisch getest voor het hele gezin
  {%- elsif style == 'eab' -%}
    {{ check_span }}32 wasbeurten per pak<br>
    {{ check_span }}Vervangt tot 60 plastic flessen per jaar<br>
    {{ check_span }}100% biologisch afbreekbaar<br>
    {{ check_span }}Geschikt voor alle wasmachines & temperaturen<br>
    {{ check_span }}Dermatologisch getest, veilig voor het hele gezin
  {%- else -%}
    {{ check_span }}Vervangt tot 60 plastic flessen per jaar<br>
    {{ check_span }}100% biologisch afbreekbaar<br>
    {{ check_span }}Geschikt voor alle wasmachines & temperaturen<br>
    {{ check_span }}Dermatologisch getest, veilig voor het hele gezin
  {%- endif -%}
</div>
