{% doc %}
  Renders the 3-column trust badge strip (Klarna, live viewers, CO2) — compact
  horizontal pills in brand pastels, Smooche-style slim benefit bar.

  @example
  {% render 'tabblie-trust-badges-pdp' %}
{% enddoc %}

<style>
  @keyframes pulse-green{0%{box-shadow:0 0 0 0 rgba(74,222,128,0.6)}70%{box-shadow:0 0 0 8px rgba(74,222,128,0)}100%{box-shadow:0 0 0 0 rgba(74,222,128,0)}}

  .tabblie-trust-strip {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 8px;
    margin-top: 8px;
  }

  .tabblie-trust-strip__item {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 10px;
    border-radius: 100px;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tabblie-trust-strip__item:hover {
    transform: translateY(-2px);
  }

  .tabblie-trust-strip__item--klarna { background: #FCE8F1; }
  .tabblie-trust-strip__item--live   { background: #E1ECFA; }
  .tabblie-trust-strip__item--co2    { background: #E2F2ED; }
  .tabblie-trust-strip__item--delivery { background: #FDF0E3; }

  .tabblie-trust-strip__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tabblie-trust-strip__label {
    font-size: 10.5px;
    font-weight: 600;
    color: #182D20;
    line-height: 1.3;
    text-align: left;
  }

  @media (max-width: 479px) {
    .tabblie-trust-strip {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    .tabblie-trust-strip__item {
      flex-direction: column;
      gap: 6px;
      padding: 10px 6px;
      border-radius: 14px;
    }
    .tabblie-trust-strip__label {
      text-align: center;
      font-size: 10.5px;
    }
  }
</style>

<div class="tabblie-trust-strip">
  <div class="tabblie-trust-strip__item tabblie-trust-strip__item--klarna">
    <span class="tabblie-trust-strip__icon">
      <img src="{{ 'pay-klarna.png' | asset_url }}" alt="Klarna" style="height:15px" loading="lazy">
    </span>
    <span class="tabblie-trust-strip__label">Eerst proberen,<br>dan betalen</span>
  </div>
  <div class="tabblie-trust-strip__item tabblie-trust-strip__item--live">
    <span class="tabblie-trust-strip__icon">
      <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 0 rgba(74,222,128,0.6);animation:pulse-green 2s infinite"></span>
    </span>
    <span class="tabblie-trust-strip__label"><span id="tabblie-scarcity">12</span> anderen<br>kijken nu ook</span>
  </div>
  <div class="tabblie-trust-strip__item tabblie-trust-strip__item--co2">
    <span class="tabblie-trust-strip__icon">
      <img src="{{ 'tabblie-carbon-footprint.png' | asset_url }}" alt="CO2-voetafdruk gecompenseerd" style="height:19px;width:19px;object-fit:contain" loading="lazy">
    </span>
    <span class="tabblie-trust-strip__label">CO2-voetafdruk<br>gecompenseerd</span>
  </div>
  <div class="tabblie-trust-strip__item tabblie-trust-strip__item--delivery">
    <span class="tabblie-trust-strip__icon">
      <svg width="18" height="18" style="width:18px;height:18px;fill:none;stroke:#E8622A" viewBox="0 0 24 24" fill="none" stroke="#E8622A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/></svg>
    </span>
    <span class="tabblie-trust-strip__label">Voor 23:59 besteld,<br>morgen in huis</span>
  </div>
</div>
<script id="tabblie-scarcity-script">
(function(){var el=document.getElementById('tabblie-scarcity');if(!el)return;function calc(){var d=new Date();var seed=d.getFullYear()*10000+d.getMonth()*100+d.getDate();var mins=d.getHours()*60+d.getMinutes();var cycle=Math.floor(mins/3);var r=((seed*31+cycle*7)%17);var v=4+r;el.textContent=v}calc();setInterval(calc,180000)})();
</script>
