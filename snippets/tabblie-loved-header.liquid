{% doc %}
  Clothesline art strip (2026-07 PDP redesign): colored clothesline + plant,
  full width of the LEFT gallery column, under the social-proof card
  (text lives in the social-proof card; no heading here).
  The UGC videos themselves render separately (tabblie-ugc-videos) on the right.

  @example
  {% render 'tabblie-loved-header' %}
{% enddoc %}

<style>
  .tabblie-loved-header .tabblie-loved-header__line { position: relative; max-width: 100%; }
</style>
<div class="tabblie-loved-header" style="position:relative;margin:26px 0 10px">
  <div class="tabblie-loved-header__line">
    {% render 'tabblie-clothesline-color', width: '100%' %}
    <div style="position:absolute;left:-20px;bottom:-14px;pointer-events:none">
      {% render 'tabblie-plant', color: '#2C6B4E', width: '48px' %}
    </div>
  </div>
</div>
