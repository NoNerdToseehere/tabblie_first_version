{% doc %}
  Renders testimonial quote + payment icons + delivery promise + guarantee badge.

  @example
  {% render 'tabblie-social-delivery' %}
{% enddoc %}

<div style="margin-top:12px">
  <div style="background:#ffffff;border-radius:14px;padding:16px 18px;margin-bottom:14px;display:flex;gap:14px;align-items:flex-start">
    <img src="{{ 'tabblie-avatar-sanne.jpg' | asset_url }}" alt="Sanne, Tabblie klant" width="56" height="56" loading="lazy" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2.5px solid #FDF6EE">
    <div>
      <p style="font-size:13px;color:#1F1209;line-height:1.55;margin:0 0 8px;font-style:italic">"Ik was sceptisch, maar deze strips werken echt net zo goed als mijn oude wasmiddel. En geen plastic meer!"</p>
      <div style="display:flex;align-items:center;gap:6px">
        <svg width="16" height="16" viewBox="0 0 256 256" fill="#3B7DD8"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z"/></svg>
        <span style="font-size:13px;font-weight:700;color:#1F1209">Sanne</span>
      </div>
    </div>
  </div>

  {% render 'tabblie-payment-icons' %}

  <div style="font-size:13px;font-weight:600;text-align:center;color:#1F1209;margin:14px 0">Bestel voor 23:59 uur, <strong>morgen</strong> in huis!</div>
  <a href="#onze-garantie" class="tabblie-guarantee-link" style="border-radius:100px;padding:12px 22px;display:flex;align-items:center;justify-content:center;gap:9px;background:linear-gradient(135deg,#E8622A 0%,#F5934A 100%);box-shadow:0 4px 14px rgba(232,98,42,0.3);text-decoration:none;cursor:pointer;transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.25s ease" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 7px 18px rgba(232,98,42,0.4)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 14px rgba(232,98,42,0.3)'">
    <span style="display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,0.25);flex-shrink:0">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </span>
    <span style="font-size:13.5px;font-weight:700;color:#ffffff">100% geld-terug-garantie voor 30 dagen</span>
  </a>
  <script>
    (function () {
      document.querySelectorAll('.tabblie-guarantee-link').forEach(function (link) {
        link.addEventListener('click', function (e) {
          var target = document.getElementById('onze-garantie');
          if (!target) return;
          e.preventDefault();
          e.stopPropagation();
          var top = target.getBoundingClientRect().top + window.pageYOffset - 90;
          window.scrollTo({ top: top, behavior: 'smooth' });
        });
      });
    })();
  </script>
</div>
