{%- liquid 
    assign icon = block.settings.icon
    assign text = block.settings.text
    assign text_description = block.settings.text_description
    assign color_icon = block.settings.color_icon
    assign color_title = block.settings.color_title
    assign color_des = block.settings.color_des
    assign fontsize_text = block.settings.fontsize_text
    assign content_popup = block.settings.content_popup
-%}
<div class="product-customInformation text-left" data-custom-information>
    {%- if icon != blank -%}
        <div class="product-customInformation__icon"
            style="--color-icon: {{ color_icon }}"
        >
            {{ icon }}
        </div>
    {%- endif -%}
    {%- if text != blank or icon != blank or text_description != blank -%}
        <div class="product-customInformation__content">
            {%- if text != blank -%}
                <div class="product__text title" {{ block.shopify_attributes }} 
                    style="--fontsize-text:{{ fontsize_text | append: 'px' }};
                    --color-title: {{ color_title }}"
                >
                    <h2 class="title">{{ text }}</h2>
                    {%- if content_popup != blank -%}
                        {% render 'icon-info-note' %}
                    {%- endif -%}
                </div>
            {%- endif -%}
            {%- if text_description != blank -%}
                <div class="product__text des" {{ block.shopify_attributes }}
                    style="--fontsize-text:{{ fontsize_text | append: 'px' }};
                    --color-des: {{ color_des }}"
                >
                    {%- comment -%} Tabblie snippets: render Liquid snippet instead of raw HTML when text matches {%- endcomment -%}
                    {%- case text -%}
                        {%- when 'tabblie-review-score' -%}
                            {% render 'tabblie-review-score' %}
                        {%- when 'tabblie-payment-icons' -%}
                            {% render 'tabblie-payment-icons' %}
                        {%- when 'tabblie-trust-badges-pdp' -%}
                            {% render 'tabblie-trust-badges-pdp' %}
                        {%- when 'tabblie-social-delivery' -%}
                            {% render 'tabblie-social-delivery' %}
                        {%- when 'tabblie-ugc-videos' -%}
                            {% render 'tabblie-ugc-videos' %}
                        {%- when 'tabblie-benefit-checks' -%}
                            {% render 'tabblie-benefit-checks' %}
                        {%- when 'tabblie-benefit-checks-eab' -%}
                            {% render 'tabblie-benefit-checks', style: 'eab' %}
                        {%- when 'tabblie-benefit-checks-mea' -%}
                            {% render 'tabblie-benefit-checks', style: 'mea' %}
                        {%- else -%}
                            {{ text_description }}
                    {%- endcase -%}
                </div>
            {%- endif -%}
        </div>
    {%- endif -%}
    {%- if content_popup != blank -%}
        <div class="product-customInformation__popup hidden">
            {{ content_popup }}
        </div>
    {%- endif -%}
</div>