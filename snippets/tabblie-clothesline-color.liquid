{% doc %}
  Colored Matisse-flat clothesline (2026-07 PDP redesign): curved rope with
  pegs and hanging clothes in brand dark-red + orange, transparent background.

  @param width - CSS width (default: 100%)

  @example
  {% render 'tabblie-clothesline-color', width: '320px' %}
{% enddoc %}

{%- assign line_width = width | default: '100%' -%}

<svg viewBox="0 0 520 190" fill="none" aria-hidden="true" style="display:block;width:{{ line_width }};height:auto">
  <!-- rope -->
  <path d="M4 38 Q 260 92 516 26" stroke="#5A2418" stroke-width="5" stroke-linecap="round" fill="none" style="fill:none"/>
  <!-- shorts (dark red) -->
  <g transform="rotate(3 62 60)">
    <rect x="34" y="52" width="56" height="26" rx="4" fill="#6E2A1C"/>
    <rect x="36" y="74" width="23" height="30" rx="7" fill="#6E2A1C"/>
    <rect x="65" y="74" width="23" height="28" rx="7" fill="#6E2A1C"/>
  </g>
  <!-- peg -->
  <rect x="58" y="42" width="6" height="14" rx="3" fill="#5A2418" transform="rotate(6 61 49)"/>
  <!-- tank top (orange) -->
  <g transform="rotate(-4 190 110)">
    <path d="M160 66l10-4c4 10 12 16 20 16s16-6 20-16l10 4-6 22 4 62c-18 8-38 8-56 0l4-62z" fill="#E8622A"/>
  </g>
  <rect x="186" y="58" width="6" height="14" rx="3" fill="#5A2418" transform="rotate(-4 189 65)"/>
  <!-- trousers (dark red) -->
  <g transform="rotate(2 285 120)">
    <path d="M262 74h46v24l-4 74a7 7 0 01-14 0l-5-52-5 52a7 7 0 01-14 0l-4-74z" fill="#6E2A1C"/>
  </g>
  <rect x="280" y="66" width="6" height="14" rx="3" fill="#5A2418" transform="rotate(3 283 73)"/>
  <!-- sock (orange) -->
  <g transform="rotate(-6 352 100)">
    <path d="M340 74h20v44c0 10-6 18-15 18-8 0-14-6-14-13 0-6 4-10 9-12z" fill="#E8622A"/>
  </g>
  <rect x="346" y="64" width="6" height="14" rx="3" fill="#5A2418" transform="rotate(-4 349 71)"/>
  <!-- folded tee (dark red) -->
  <g transform="rotate(4 425 96)">
    <rect x="396" y="62" width="58" height="52" rx="6" fill="#6E2A1C"/>
    <path d="M396 74l-12 8 8 12 4-4z" fill="#6E2A1C"/>
    <path d="M454 74l12 8-8 12-4-4z" fill="#6E2A1C"/>
  </g>
  <rect x="420" y="52" width="6" height="14" rx="3" fill="#5A2418" transform="rotate(4 423 59)"/>
  <!-- knotted cloth (dark red) -->
  <g transform="rotate(8 487 66)">
    <path d="M474 48c6-8 18-8 24 0 4 6 2 14-4 18l6 14c-8 6-18 6-26 0l6-14c-6-4-8-12-6-18z" fill="#6E2A1C"/>
  </g>
</svg>
