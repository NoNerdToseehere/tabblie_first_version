    "tabblie_faq_pdp": {
      "type": "tabblie-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "Werken de strips echt zo goed als vloeibaar wasmiddel?",
            "answer": "Ja. Onze strips bevatten dezelfde werkzame stoffen als premium wasmiddelen, alleen dan in geconcentreerde, vaste vorm. Ze lossen volledig op in koud én warm water (vanaf 30°C). Geen residu, geen restjes, geen verschil in resultaat — wel een groot verschil in plasticafval."
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "Hoeveel wasbeurten zitten er in één pak?",
            "answer": "32 wasbeurten per pak. Eén strip = één was. Voor extra vuile was kun je een halve strip extra gebruiken. Bij normaal gebruik (2-3 wasjes per week) doe je dus zo’n 3 maanden met één pak."
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Zijn de strips veilig voor gevoelige huid en kinderkleding?",
            "answer": "Volledig. Onze formule is dermatologisch getest, hypoallergeen, en vrij van parabenen, fosfaten, kleurstoffen en kunstmatige geurstoffen. Veilig voor babykleding, huidvriendelijk voor de hele familie."
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Werken ze ook op koude wasprogrammas?",
            "answer": "Ja, ze lossen perfect op vanaf 20°C. Dat scheelt je flink op de energierekening én is beter voor je kleding én de planeet."
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "Wat zit er precies in?",
            "answer": "Plantaardige zepen (kokosolie, palmolievrij), biologisch afbreekbare enzymen die vlekken aanpakken, plantaardige weekmakers en een lichte, natuurlijke geur. Geen microplastics, geen optische witmakers, geen zooi. De volledige ingrediëntenlijst staat op de verpakking en op de productpagina."
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "Geschikt voor alle wasmachines?",
            "answer": "Ja, voor alle types: voorlader, bovenlader, condensdroger combo. Stop de strip in de trommel (niet in het zeepbakje) voordat je je was erin doet. Dat’s it."
          }
        },
        "q7": {
          "type": "faq",
          "settings": {
            "question": "Hoe zit het met sterke vlekken zoals rode wijn of gras?",
            "answer": "Voor hardnekkige vlekken: voorbehandel de plek door een stukje strip met wat water tot een pasta te maken en kort te laten intrekken. Dan gewoon meewassen. Werkt op de meeste vlekken even goed als gespecialiseerde voorbehandelaars."
          }
        },
        "q8": {
          "type": "faq",
          "settings": {
            "question": "Hoe bewaar ik de strips?",
            "answer": "Op een droge plek, kamertemperatuur. De papieren verpakking houdt ze maximaal 18 maanden goed. Niet in de badkamer bewaren — vocht laat de strips voortijdig oplossen."
          }
        },
        "q9": {
          "type": "faq",
          "settings": {
            "question": "Wat als ze niet bevallen?",
            "answer": "Geen probleem. Je hebt 30 dagen om ze risicovrij te proberen. Niet tevreden? Stuur ze terug en we storten je geld terug — geen vragen, geen gedoe."
          }
        },
        "q10": {
          "type": "faq",
          "settings": {
            "question": "Wanneer wordt mijn bestelling geleverd?",
            "answer": "Bestellingen vóór 15:00 uur versturen we dezelfde werkdag. Levering in Nederland duurt 1-2 werkdagen, in België 2-3 werkdagen. Verzending is altijd gratis."
          }
        },
        "q11": {
          "type": "faq",
          "settings": {
            "question": "Bieden jullie abonnementen aan?",
            "answer": "Binnenkort. We werken aan een abonnementsmodel waarmee je 15% korting krijgt op elke bestelling, met automatische levering op jouw ritme (elke 4, 8 of 12 weken). Pauzeren of stoppen kan altijd. Schrijf je in voor onze nieuwsbrief om als eerste te horen wanneer het live gaat."
          }
        },
        "q12": {
          "type": "faq",
          "settings": {
            "question": "Hoe zit het met jullie CO2-voetafdruk?",
            "answer": "We compenseren de CO2-voetafdruk van onze volledige toeleveringsketen — van grondstof tot bezorging bij jou thuis — via gecertificeerde klimaatprojecten zoals herbebossing en schone energie. Elke bestelling is dus klimaatneutraal."
          }
        }
