    "tabblie_faq_main": {
      "type": "tabblie-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Zijn jullie strips echt zonder plastic?",
            "answer": "Ja! Onze strips worden verpakt in recyclebaar papier. Geen plastic fles, geen plastic verpakking, geen microplastics in de formule."
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Werken de strips net zo goed als vloeibaar wasmiddel?",
            "answer": "Ja. Onze strips zijn supergeconcentreerd: het water dat in een gewone fles wasmiddel zit (vaak 80 tot 90% van de inhoud), laten wij gewoon weg. Wat overblijft, zijn de werkzame stoffen die je was schoon krijgen — alleen dan zonder al dat meegesleepte water en plastic."
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Hoe zit het met de verzending?",
            "answer": "Gratis bezorgd in Nederland en België — en zo licht dat het bijna vanzelf gaat. De CO₂ van het transport? Die compenseren we, zodat jouw bestelling klimaatneutraal op de mat valt."
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Hoelang duurt de verzending?",
            "answer": "Voor je het weet. Bestel op een werkdag vóór 16:00 en je strips gaan diezelfde dag op weg — in het weekend of op een feestdag pakken we 'm de eerstvolgende werkdag op. Binnen 1-2 werkdagen ploft het doosje door je brievenbus, geen thuisblijven nodig."
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_4",
        "faq_5"
      ],
      "settings": {
        "icon": "question",
        "eyebrow": "VEELGESTELDE VRAGEN",
        "title": "Alles wat je wilt weten"
      }
    },
