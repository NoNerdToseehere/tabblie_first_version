    "tabblie_impact_main": {
      "type": "tabblie-impact",
      "settings": {
        "eyebrow": "GENOEG GESJOUWD",
        "heading": "Wij vonden het ook een gedoe",
        "description": "Zware flessen sjouwen. Eindeloos afmeten. Morsen en plakkerige doppen. Een kast vol plasticflessen. En een prullenbak vol plastic. Wij vonden het ook een gedoe — dus maakten we er één simpel stripje van. Vederlicht, plat en compact: een heel doosje past door de brievenbus en verdwijnt zo in een la. Geen gesjouw, geen plastic, geen kast vol flessen meer. Gewoon een strip eruit, erin, en klaar — voor de was, de vaat én het toilet.",
        "button_text": "Ook minder gedoe? - bekijk hier",
        "button_url": ""
      }
