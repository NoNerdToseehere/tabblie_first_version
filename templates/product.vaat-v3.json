    "tabblie_faq": {
      "type": "tabblie-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "Werkt het in elke vaatwasser?",
            "answer": "<p>Ja — in elk merk en elk model, op elk programma. Ook op eco en korte programma's.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "Waar leg ik de strip?",
            "answer": "<p>In het bestekmandje of het tabletvak. De strip lost volledig op, zonder resten.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Komen mijn glazen er streeploos uit?",
            "answer": "<p>Ja — citroenzuur beschermt tegen kalk. Bij zeer hard water kun je het glansspoelmiddelvakje gevuld houden zoals je gewend bent.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Zit er PVA of plastic folie omheen?",
            "answer": "<p>Nee. Geen PVA-folie, geen plastic wikkels — de strips zijn 100% plastic- & microplasticvrij en verpakt in papier.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "Werkt het ook bij aangekoekte pannen?",
            "answer": "<p>Natuurlijke enzymen breken vet en zetmeel af. Voor zwaar aangekoekte pannen geldt hetzelfde als bij tabletten: even voorweken helpt.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "Hoe werkt de geld-terug-garantie?",
            "answer": "<p>Je hebt 30 dagen om te proberen. Niet tevreden? Mail support@tabblie.com en je krijgt je geld terug — zonder gedoe.</p>"
          }
        },
        "q7": {
          "type": "faq",
          "settings": {
            "question": "Wat kost verzending en hoe snel is het er?",
            "answer": "<p>Verzending is gratis in Nederland en België. Voor 23:59 besteld? Morgen in huis — en de verpakking past door de brievenbus.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
